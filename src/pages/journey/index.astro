---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/journey.css';
import 'leaflet/dist/leaflet.css';
import journeyAudio from '../../../audio/background-music.mp3?url';
const base=import.meta.env.BASE_URL;
---
<BaseLayout active="journey" title="Reise" description="En langsom reise gjennom norske sagn og landskap.">
  <section id="legend-journey" data-endpoint={`${base}journey-data.json`} data-i18n-skip tabindex="-1">
    <div id="journey-map"></div>
    <div class="journey-shade" aria-hidden="true"></div>
    <header class="journey-map-heading"><span id="journey-location-kind"></span><p id="map-heading">Norge</p><span id="journey-location-detail"></span></header>
    <div class="journey-top-tools journey-chrome">
      <button id="journey-settings-toggle" type="button" aria-label="Map settings" aria-expanded="false" aria-controls="journey-settings"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="3" fill="#122129"/><circle cx="15" cy="17" r="3" fill="#122129"/></svg></button>
      <button id="journey-info-toggle" type="button">Info</button><button id="journey-fullscreen" type="button"></button><button id="journey-close" type="button" hidden>×</button>
    </div>
    <section id="journey-settings" class="journey-settings" aria-labelledby="journey-settings-title" hidden>
      <h2 id="journey-settings-title">Journey settings</h2>
      <div class="journey-playback-settings">
        <button id="journey-sound" type="button" aria-pressed="false"></button>
        <button id="journey-motion" type="button" aria-pressed="false"></button>
      </div>
      <p class="journey-settings-credit"><a href="https://pixabay.com/users/playstarz_music-52864946/" target="_blank" rel="noopener" id="journey-credit"></a></p>
      <h3 id="journey-map-settings-title">Map atmosphere</h3>
      <div role="group" aria-labelledby="journey-map-settings-title">
        <button type="button" data-map-type="coastlines" aria-pressed="true"><span></span><small></small></button>
        <button type="button" data-map-type="quiet" aria-pressed="false"><span></span><small></small></button>
        <button type="button" data-map-type="terrain" aria-pressed="false"><span></span><small></small></button>
      </div>
      <div class="journey-reading-settings">
        <label id="journey-reading-time-label" for="journey-reading-time">Reading time</label>
        <input id="journey-reading-time" type="range" min="70" max="200" step="10" value="100" aria-describedby="journey-reading-time-note" />
        <div class="journey-range-labels"><span id="journey-reading-less">Less time</span><span id="journey-reading-more">More time</span></div>
        <output id="journey-reading-time-note" for="journey-reading-time"></output>
      </div>
    </section>
    <div id="journey-welcome" class="journey-welcome"></div>
    <div id="journey-caption" class="journey-caption" aria-live="polite" aria-atomic="true" hidden></div>
    <section id="journey-reading" class="journey-reading" hidden aria-label="Legend">
      <div class="journey-reading-top"><h2 id="journey-title"></h2><span id="journey-page"></span></div>
      <div id="journey-passage" class="journey-passage" aria-live="polite" aria-atomic="true"></div>
      <div id="journey-byline" class="journey-byline"></div>
      <div class="journey-time-track" aria-hidden="true"><div id="journey-time-fill"></div></div>
    </section>
    <article id="journey-moe-card" class="journey-moe-card" hidden aria-live="polite"></article>
    <dialog id="journey-info" class="journey-info"><button id="journey-info-close" type="button" aria-label="Close / Lukk">Close / Lukk</button><h2 id="journey-info-title"></h2><div id="journey-info-content"></div></dialog>
    <div id="journey-ending" class="journey-ending" hidden></div>
    <div class="journey-bottom journey-chrome">
      <div id="journey-status" role="status" aria-live="polite"></div>
      <nav class="journey-controls" aria-label="Journey controls">
        <button id="journey-back" type="button" hidden></button>
        <button id="journey-pause" type="button" hidden></button>
        <button id="journey-next" type="button" hidden></button>
      </nav>
      <p class="journey-footnote"><span id="journey-progress"></span><span id="journey-route-note"></span><a id="journey-source" hidden target="_blank" rel="noopener"></a></p>
    </div>
    <audio id="journey-audio" src={journeyAudio} loop preload="none"></audio>
  </section>
  <script>import '../../journey/main.js';</script>
</BaseLayout>
