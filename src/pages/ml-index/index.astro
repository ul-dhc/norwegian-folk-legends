---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {types,topics} from '../../ml-index/data';
import '../../ml-index/style.css';
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="ML-indeks" active="ml" description="Browse migratory legend topics and types in the Norwegian folk legend collection.">
 <div class="ml-page shell" data-i18n-skip>
  <header class="ml-hero"><p class="eyebrow" data-ml-copy="eyebrow">Vandresagn · en inngang til samlingen</p><h1 data-ml-copy="title">ML-indeks</h1><p class="ml-lede" data-ml-copy="intro">Finn beslektede sagn gjennom temaer og typer.</p><div class="ml-summary"><span><strong>{types.length}</strong> <span data-ml-copy="types">sagntyper</span></span><span><strong>{types.reduce((n,t)=>n+t.records.length,0).toLocaleString('no-NO')}</strong> <span data-ml-copy="records">opptegnelser</span></span><a href="#ml-method" data-ml-copy="about">Hva er en ML-type?</a></div></header>
  <section id="ml-contents"><div class="ml-view-intro"><h2 data-ml-copy="contentsTitle">Finn sagn gjennom innholdsfortegnelsen</h2><p data-ml-copy="contentsHint">Åpne et tema og velg en type. Sagnene åpnes i sagnutforskeren, der du kan lese, søke og filtrere videre.</p></div><div class="ml-contents-tools"><label class="ml-search-label" for="ml-search"><span class="sr-only" data-ml-copy="searchLabel">Søk etter kode eller tittel</span><input id="ml-search" type="search" placeholder="ML 3020, huldra, witch…" autocomplete="off"/></label><div><button type="button" data-expand-all data-ml-copy="expandAll">Åpne alle temaer</button><button type="button" data-collapse-all data-ml-copy="collapseAll">Lukk alle</button></div></div><p id="ml-count" class="ml-search-status" role="status"></p><div id="ml-toc">{topics.map(group=>{const groupTypes=types.filter(t=>t.topic===group.id);return <details class="ml-topic-section" data-toc-topic={group.id}><summary><i data-lucide="chevron-right"></i><span>{group.no}</span><small>ML {group.min}–{group.max}</small><b>{groupTypes.reduce((n,t)=>n+t.records.length,0)} sagn</b></summary><div class="ml-toc-body"><a class="ml-topic-explore" href={`${base}browse/?theme=${encodeURIComponent(groupTypes.map(t=>t.id).join(','))}`}>Utforsk hele temaet</a><ul>{groupTypes.map(type=><li><span class="ml-code">{type.code}</span><a href={`${base}browse/?theme=${encodeURIComponent(type.id)}`}>{type.no}</a><span>{type.records.length} sagn</span></li>)}</ul></div></details>})}</div><p id="ml-no-types" hidden data-ml-copy="empty">Ingen typer funnet. Prøv en annen kode eller tittel.</p></section>

  <noscript><p>Innholdsfortegnelsen kan brukes uten JavaScript. / The table of contents works without JavaScript.</p></noscript>
  <details class="ml-method" id="ml-method"><summary data-ml-copy="about">Hva er en ML-type?</summary><div class="ml-method-grid"><div><p class="eyebrow" data-ml-copy="methodEyebrow">En nøkkel til materialet</p><h2 data-ml-copy="methodTitle">Les typer gjennom variantene</h2><p data-ml-copy="method">ML står for The Migratory Legends, Reidar Th. Christiansens katalog fra 1958, senere utvidet av Inger Christiansen. En type samler beslektede fortellinger etter motiv. Den er et redskap for å finne og sammenligne varianter.</p><a href="https://samla.no/viewer/typekatalog/segn/" target="_blank" rel="noopener" class="icon-link"><span data-ml-copy="source">Om typekatalogen hos SAMLA</span><i data-lucide="external-link"></i></a></div></div></details>
 </div>
 <script type="application/json" id="ml-data" is:inline set:html={JSON.stringify({types,topics,base}).replace(/</g,'\u003c')}/>
 <script>import '../../ml-index/main';</script>
</BaseLayout>
