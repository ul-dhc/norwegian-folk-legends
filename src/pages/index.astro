---
import BaseLayout from '../layouts/BaseLayout.astro';
import {legends,collectors,narrators,places,mlCategories,resolveLegend,displayPersonName} from '../lib/data';
const base=import.meta.env.BASE_URL;
const today=new Date(),dayNumber=Math.floor(Date.UTC(today.getUTCFullYear(),today.getUTCMonth(),today.getUTCDate())/86400000),daily=legends[dayNumber%legends.length],dailyData=resolveLegend(daily);
const excerpt=(daily.text.no||'').replace(/\s+/g,' ').trim(),dailyExcerpt=excerpt.length>520?`${excerpt.slice(0,520).trimEnd()}…`:excerpt;
const attribution=[[dailyData.place?.name,dailyData.county?.name,daily.year].filter(Boolean).join(' · '),displayPersonName(dailyData.narrator),displayPersonName(dailyData.collector)].filter(Boolean);
const knownCollectors=collectors.filter(item=>displayPersonName(item)).length,knownNarrators=narrators.filter(item=>displayPersonName(item)).length;
---
<BaseLayout active="home" title="Norske sagn">
  <section class="hero norske-home-hero"><div class="shell"><p class="home-development"><span class="development-badge" data-i18n="status.development">Under utvikling</span></p><h1 class="display">Norske sagn</h1><p class="lede" data-i18n="home.intro">Utforsk 1 477 norske sagn gjennom fortellinger, steder, samlere og vandresagntyper.</p><form class="hero-search" action={`${base}browse/`} method="get"><label class="sr-only" for="home-search" data-i18n="common.search">Søk</label><input id="home-search" name="q" type="search" placeholder="Søk i sagn, steder eller personer…"/><button class="button primary" type="submit" data-i18n="common.search">Søk</button></form><div class="hero-actions"><a class="button icon-link" href={`${base}browse/`}><span data-i18n="home.openBrowser">Åpne sagnutforskeren</span><i data-lucide="arrow-right"></i></a></div></div></section>
  <section class="shell stats collection-summary" aria-label="Samlingsstatistikk"><div class="stat"><i data-lucide="file-stack"></i><strong>{legends.length.toLocaleString('no-NO')}</strong><span data-i18n="common.legends">sagn</span></div><div class="stat"><i data-lucide="notebook-pen"></i><strong>{knownCollectors.toLocaleString('no-NO')}</strong><span data-i18n="common.collectors">samlere</span></div><div class="stat"><i data-lucide="users-round"></i><strong>{knownNarrators.toLocaleString('no-NO')}</strong><span data-i18n="common.informants">informanter</span></div><div class="stat"><i data-lucide="map-pin"></i><strong>{places.length.toLocaleString('no-NO')}</strong><span data-i18n="common.places">steder</span></div></section>
  <section class="section shell daily-section"><div class="daily-icon" aria-hidden="true"><span class="calendar-mark"><i data-lucide="calendar-days"></i></span><span class="calendar-label" data-i18n="home.today">I dag</span></div><article class="daily-legend"><div class="daily-heading"><div class="eyebrow" data-i18n="home.daily">Dagens sagn</div></div><h2><a href={`${base}legends/${daily.id}/`}>{daily.title.no||daily.id}</a></h2><p class="daily-excerpt">{dailyExcerpt}</p>{attribution.length>0&&<p class="daily-attribution">{attribution.join(' · ')}</p>}<a class="button icon-link" href={`${base}legends/${daily.id}/`}><span data-i18n="home.readDaily">Les sagnet</span><i data-lucide="arrow-right"></i></a></article></section>
  <section class="section home-modules"><div class="shell"><div class="section-head"><div><p class="eyebrow" data-i18n="home.nextModules">Neste moduler</p><h2 data-i18n="home.exploreMore">Flere måter å utforske samlingen på</h2></div></div><div class="featured"><article class="feature is-inactive"><i data-lucide="map-pin"></i><h3 data-i18n="nav.map">Kart</h3><p data-i18n="home.mapDescription">Utforsk sagn etter sted og fylke.</p></article><article class="feature is-inactive"><i data-lucide="layers"></i><h3 data-i18n="nav.ml">ML-indeks</h3><p data-i18n="home.mlDescription">Bla gjennom Migratory Legend-kategoriene.</p></article><a class="feature feature-link" href={`${base}journey/`}><i data-lucide="network"></i><h3 data-i18n="nav.journey">Reise</h3><p data-i18n="home.journeyDescription">Følg forbindelser mellom fortellinger, steder og mennesker.</p></a></div><p class="home-data-note"><strong>{mlCategories.length}</strong> <span data-i18n="common.mlTypes">ML-typer</span></p></div></section>
  <style>
    .home-development{margin:.8rem 0 .9rem}.home-development .development-badge{font-size:.7rem;padding:.28rem .65rem}
    .collection-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:-46px;padding:1.15rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--paper),transparent 4%)}
    .collection-summary .stat,.collection-summary .stat:nth-child(4),:global(:root[data-theme=dark]) .collection-summary .stat{--stat-color:var(--blue);min-height:84px;padding:.65rem clamp(1rem,2.5vw,2rem);display:grid;grid-template-columns:30px 1fr;grid-template-rows:auto auto;column-gap:.85rem;align-content:center;border:0;border-radius:0;background:transparent;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none}
    .collection-summary .stat:nth-child(2){--stat-color:var(--stat-green)}.collection-summary .stat:nth-child(3){--stat-color:var(--pin)}.collection-summary .stat:nth-child(4){--stat-color:var(--place-blue)}
    .collection-summary .stat+.stat{border-left:1px solid var(--line)}
    .collection-summary .stat>.lucide{grid-column:1;grid-row:1/3;width:21px;height:21px;align-self:center;color:var(--stat-color);filter:none}
    .collection-summary .stat strong,.collection-summary .stat span{grid-column:2;margin:0}.collection-summary .stat strong{grid-row:1;color:var(--ink);font:500 clamp(2rem,3vw,2.65rem)/1 var(--serif);letter-spacing:-.035em}.collection-summary .stat span{grid-row:2;margin-top:.18rem;color:var(--muted);font-size:.68rem;font-weight:650;letter-spacing:.1em;text-transform:uppercase}
    .collection-summary .stat:hover,.collection-summary .stat:nth-child(2):hover,.collection-summary .stat:nth-child(3):hover,.collection-summary .stat:nth-child(4):hover,:global(:root[data-theme=dark]) .collection-summary .stat:hover{transform:none;border-color:var(--line);background:transparent;box-shadow:none}.collection-summary .stat:hover strong{color:var(--ink);text-shadow:none}.collection-summary .stat:hover>.lucide{color:var(--stat-color);filter:none;transform:none}
    :global(:root[data-theme=dark]) .collection-summary{border-color:var(--line);background:color-mix(in srgb,var(--paper),var(--raised) 22%)}:global(:root[data-theme=dark]) .collection-summary .stat{border-color:var(--line);background:transparent}
    .feature-link{display:block;color:inherit;text-decoration:none}.feature-link:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 8px 24px #0001}.feature-link>svg{color:var(--accent)}
    @media(max-width:850px){.collection-summary{grid-template-columns:repeat(2,1fr)}.collection-summary .stat:nth-child(3){border-left:0}.collection-summary .stat:nth-child(3),.collection-summary .stat:nth-child(4){border-top:1px solid var(--line)}}
    @media(max-width:600px){.collection-summary{grid-template-columns:1fr;margin-top:1rem;padding:.35rem 0}.collection-summary .stat,.collection-summary .stat:nth-child(4),:global(:root[data-theme=dark]) .collection-summary .stat{min-height:76px;padding:.75rem 1rem}.collection-summary .stat+.stat{border-left:0;border-top:1px solid var(--line)}.collection-summary .stat strong{font-size:2rem}}
  </style>
</BaseLayout>
