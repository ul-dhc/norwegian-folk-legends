---
import BaseLayout from '../layouts/BaseLayout.astro';
import {legends,collectors,narrators,places,mlCategories,resolveLegend,displayPersonName} from '../lib/data';
const base=import.meta.env.BASE_URL;
const today=new Date(),dayNumber=Math.floor(Date.UTC(today.getUTCFullYear(),today.getUTCMonth(),today.getUTCDate())/86400000),daily=legends[dayNumber%legends.length],dailyData=resolveLegend(daily);
const excerpt=(daily.text.no||'').replace(/\s+/g,' ').trim(),dailyExcerpt=excerpt.length>520?`${excerpt.slice(0,520).trimEnd()}…`:excerpt;
const attribution=[[dailyData.place?.name,dailyData.county?.name,daily.year].filter(Boolean).join(' · '),displayPersonName(dailyData.narrator),displayPersonName(dailyData.collector)].filter(Boolean);
const knownCollectors=collectors.filter(item=>displayPersonName(item)).length,knownNarrators=narrators.filter(item=>displayPersonName(item)).length;
---
<BaseLayout active="home" title="Norske sagn">
  <section class="hero norske-home-hero"><div class="shell"><p class="eyebrow" data-i18n="home.eyebrow">Norsk folketradisjon</p><h1 class="display">Norske sagn</h1><p class="lede" data-i18n="home.intro">Utforsk 1 477 norske sagn gjennom fortellinger, steder, samlere og vandresagntyper.</p><form class="hero-search" action={`${base}browse/`} method="get"><label class="sr-only" for="home-search" data-i18n="common.search">Søk</label><input id="home-search" name="q" type="search" placeholder="Søk i sagn, steder eller personer…"/><button class="button primary" type="submit" data-i18n="common.search">Søk</button></form><div class="hero-actions"><a class="button icon-link" href={`${base}browse/`}><span data-i18n="home.openBrowser">Åpne sagnutforskeren</span><i data-lucide="arrow-right"></i></a></div></div></section>
  <section class="shell stats" aria-label="Samlingsstatistikk"><div class="stat"><i data-lucide="file-stack"></i><strong>{legends.length.toLocaleString('no-NO')}</strong><span data-i18n="common.legends">sagn</span></div><div class="stat"><i data-lucide="notebook-pen"></i><strong>{knownCollectors.toLocaleString('no-NO')}</strong><span data-i18n="common.collectors">samlere</span></div><div class="stat"><i data-lucide="users-round"></i><strong>{knownNarrators.toLocaleString('no-NO')}</strong><span data-i18n="common.informants">informanter</span></div><div class="stat"><i data-lucide="map-pin"></i><strong>{places.length.toLocaleString('no-NO')}</strong><span data-i18n="common.places">steder</span></div></section>
  <section class="section shell daily-section"><div class="daily-icon" aria-hidden="true"><span class="calendar-mark"><i data-lucide="calendar-days"></i></span><span class="calendar-label" data-i18n="home.today">I dag</span></div><article class="daily-legend"><div class="daily-heading"><div class="eyebrow" data-i18n="home.daily">Dagens sagn</div></div><h2><a href={`${base}legends/${daily.id}/`}>{daily.title.no||daily.id}</a></h2><p class="daily-excerpt">{dailyExcerpt}</p>{attribution.length>0&&<p class="daily-attribution">{attribution.join(' · ')}</p>}<a class="button icon-link" href={`${base}legends/${daily.id}/`}><span data-i18n="home.readDaily">Les sagnet</span><i data-lucide="arrow-right"></i></a></article></section>
  <section class="section home-modules"><div class="shell"><div class="section-head"><div><p class="eyebrow" data-i18n="home.nextModules">Neste moduler</p><h2 data-i18n="home.exploreMore">Flere måter å utforske samlingen på</h2></div></div><div class="featured"><article class="feature is-inactive"><i data-lucide="map-pin"></i><h3 data-i18n="nav.map">Kart</h3><p data-i18n="home.mapDescription">Utforsk sagn etter sted og fylke.</p></article><article class="feature is-inactive"><i data-lucide="layers"></i><h3 data-i18n="nav.ml">ML-indeks</h3><p data-i18n="home.mlDescription">Bla gjennom Migratory Legend-kategoriene.</p></article><article class="feature is-inactive"><i data-lucide="network"></i><h3 data-i18n="nav.journey">Reise</h3><p data-i18n="home.journeyDescription">Følg forbindelser mellom fortellinger, steder og mennesker.</p></article></div><p class="home-data-note"><strong>{mlCategories.length}</strong> <span data-i18n="common.mlTypes">ML-typer</span></p></div></section>
</BaseLayout>
