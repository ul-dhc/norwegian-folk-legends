---
import BaseLayout from '../layouts/BaseLayout.astro';
import {legends,collectors,narrators,places,resolveLegend,displayPersonName,collectorsById,narratorsById} from '../lib/data';
import norway from '../data/norway-outline.json';
import {topics,types} from '../ml-index/data';
import {BookOpen,Moon,Flame,Waves,Mountain,Trees,House,Castle} from 'lucide';
const topicIcons={magic:BookOpen,witchcraft:Moon,ghosts:Flame,water:Waves,trolls:Mountain,fairies:Trees,nisse:House,local:Castle};
import livPhotograph from '../assets/moe/liv-bratterud.jpg?url';
import threadsMeetPreview from '../assets/journey-previews/threads-meet.png?url';
import oneThreadPreview from '../assets/journey-previews/one-thread.png?url';
const base=import.meta.env.BASE_URL;
const mappedLegends=legends.filter(legend=>legend.originalCoordinates);
const locationTotals=new Map<string,number>();
const mapPoints=mappedLegends.map(legend=>{
  const {latitude,longitude}=legend.originalCoordinates!;
  const key=`${latitude},${longitude}`,index=locationTotals.get(key)||0;
  locationTotals.set(key,index+1);
  // A small deterministic spread keeps every record visible at shared locations.
  const angle=index*2.39996323,radius=index?Math.sqrt(index)*1.6:0;
  return {id:legend.id,x:24+(longitude-4)*22+Math.cos(angle)*radius,y:24+(72-latitude)*43+Math.sin(angle)*radius};
});
const homeTopics=topics.map(topic=>{
  const topicTypes=types.filter(type=>type.topic===topic.id&&type.records.length);
  const ids=topicTypes.map(type=>type.id),records=legends.filter(legend=>ids.includes(legend.mlCategoryId||''));
  const collectorCount=new Set(records.filter(legend=>displayPersonName(collectorsById.get(legend.collectorId||''))).map(legend=>legend.collectorId)).size;
  const narratorCount=new Set(records.filter(legend=>displayPersonName(narratorsById.get(legend.narratorId||''))).map(legend=>legend.narratorId)).size;
  return {...topic,count:records.length,ids,collectorCount,narratorCount};
}).filter(topic=>topic.count);
const journeys=[
  {mode:'weave',title:'Der trådene møtes',key:'weave',description:'En åpen reise gjennom steder, stemmer og sagn. Følg forbindelsene som vokser frem i landskapet.'},
  {mode:'thread',title:'Én tråd',key:'thread',description:'Et rop fra vannet, et møte med huldra, en hvileløs ånd. Følg et tema fra sted til sted.'},
  {mode:'moe',title:'Moltke Moe',key:'moe',description:'Møt stemmene fra Bø gjennom sagn, fotografier og håndskrevne sider fra arkivet.'}
];
const today=new Date(),currentDate=new Intl.DateTimeFormat('nb-NO',{timeZone:'Europe/Oslo',day:'2-digit',month:'2-digit',year:'numeric'}).format(today),currentDateISO=new Intl.DateTimeFormat('sv-SE',{timeZone:'Europe/Oslo',year:'numeric',month:'2-digit',day:'2-digit'}).format(today),dayNumber=Math.floor(Date.UTC(today.getUTCFullYear(),today.getUTCMonth(),today.getUTCDate())/86400000),daily=legends[dayNumber%legends.length],dailyData=resolveLegend(daily);
const excerpt=(daily.text.no||'').replace(/\s+/g,' ').trim(),dailyExcerpt=excerpt.length>520?`${excerpt.slice(0,520).trimEnd()}…`:excerpt;
const attribution=[[dailyData.place?.name,dailyData.county?.name,daily.year].filter(Boolean).join(' · '),displayPersonName(dailyData.narrator),displayPersonName(dailyData.collector)].filter(Boolean);
const knownCollectors=collectors.filter(item=>displayPersonName(item)).length,knownNarrators=narrators.filter(item=>displayPersonName(item)).length;
---
<BaseLayout active="home" title="Norske sagn">
  <section class="hero norske-home-hero"><div class="shell home-introduction"><div class="home-copy"><p class="home-development"><span class="development-badge" data-i18n="status.development">Under utvikling</span></p><h1 class="display">Norske sagn</h1><p class="lede" data-i18n="home.intro">Utforsk 1 477 norske sagn gjennom fortellinger, steder, samlere og vandresagntyper.</p><form class="hero-search" action={`${base}browse/`} method="get"><label class="sr-only" for="home-search" data-i18n="common.search">Søk</label><input id="home-search" name="q" type="search" placeholder="Søk i sagn, steder eller personer…"/><button class="button primary" type="submit" data-i18n="common.search">Søk</button></form><div class="hero-actions"><a class="button icon-link" href={`${base}browse/`}><span data-i18n="home.openBrowser">Åpne sagnutforskeren</span><i data-lucide="arrow-right"></i></a></div></div><figure class="norway-map"><svg viewBox="20 40 620 610" role="img" aria-labelledby="norway-map-title norway-map-description"><title id="norway-map-title" data-i18n="home.mapTitle">Sagn i landskapet</title><desc id="norway-map-description" data-i18n="home.mapAlt">Et kart over Norge med ett lyspunkt for hvert stedfestet sagn.</desc><defs><radialGradient id="norway-ambient-light" gradientUnits="userSpaceOnUse" cx="310" cy="345" r="220"><stop offset="0" stop-color="#ead9b3" stop-opacity=".95"/><stop offset=".35" stop-color="#ddcfae" stop-opacity=".65"/><stop offset=".7" stop-color="#c8dace" stop-opacity=".2"/><stop offset="1" stop-color="#c8dace" stop-opacity="0"/></radialGradient></defs><path class="norway-outline" d={norway.path}/><path class="norway-land-wash" d={norway.path} fill="url(#norway-ambient-light)"/><g class="norway-lights">{mapPoints.map(point=><circle cx={point.x} cy={point.y} r="1.65" data-legend-id={point.id}/>)}</g><g class="norway-light-wash" fill="url(#norway-ambient-light)" aria-hidden="true">{mapPoints.map(point=><circle cx={point.x} cy={point.y} r="1.8"/>)}</g></svg></figure></div></section>
  <section class="shell stats collection-summary" aria-label="Samlingsstatistikk"><div class="stat"><i data-lucide="file-stack"></i><strong data-count-up={legends.length}>{legends.length.toLocaleString('no-NO')}</strong><span data-i18n="common.legends">sagn</span></div><div class="stat"><i data-lucide="notebook-pen"></i><strong data-count-up={knownCollectors}>{knownCollectors.toLocaleString('no-NO')}</strong><span data-i18n="common.collectors">samlere</span></div><div class="stat"><i data-lucide="users-round"></i><strong data-count-up={knownNarrators}>{knownNarrators.toLocaleString('no-NO')}</strong><span data-i18n="common.informants">informanter</span></div><div class="stat"><i data-lucide="map-pin"></i><strong data-count-up={places.length}>{places.length.toLocaleString('no-NO')}</strong><span data-i18n="common.places">steder</span></div></section>
  <section class="section shell daily-section"><div class="daily-icon"><span class="calendar-mark"><i data-lucide="calendar-days"></i></span><span class="calendar-label" data-i18n="home.today">I dag</span><time data-daily-date datetime={currentDateISO}>{currentDate}</time></div><article class="daily-legend"><div class="daily-heading"><div class="eyebrow" data-i18n="home.daily">Dagens sagn</div></div><h2><a href={`${base}legends/${daily.id}/`}>{daily.title.no||daily.id}</a></h2><p class="daily-excerpt">{dailyExcerpt}</p>{attribution.length>0&&<p class="daily-attribution">{attribution.join(' · ')}</p>}<a class="button icon-link" href={`${base}legends/${daily.id}/`}><span data-i18n="home.readDaily">Les sagnet</span><i data-lucide="arrow-right"></i></a></article></section>
  <section class="section shell home-topics" aria-labelledby="topics-title">
    <div class="section-head"><h2 id="topics-title" data-i18n="home.topicsTitle">Temaer i samlingen</h2></div>
    <div class="topic-blocks">{homeTopics.map(topic=><a class="topic-block" href={`${base}browse/?theme=${encodeURIComponent(topic.ids.join(','))}`} data-topic-id={topic.id}>
      <svg class="topic-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{topicIcons[topic.id as keyof typeof topicIcons].map(([Tag,attributes])=><Tag {...attributes}/>)}</svg>
      <h3 data-topic-copy data-i18n-skip data-no={topic.no} data-en={topic.en}>{topic.no}</h3>
      <div class="topic-totals">
        <span><strong>{topic.count}</strong><span data-i18n="common.legends">sagn</span></span>
        <span><strong>{topic.collectorCount}</strong><span data-i18n="common.collectors">samlere</span></span>
        <span><strong>{topic.narratorCount}</strong><span data-i18n="common.informants">informanter</span></span>
      </div>
    </a>)}</div>
  </section>
  <section class="section shell home-journeys" aria-labelledby="journeys-title"><div class="section-head"><div><p class="eyebrow" data-i18n="home.journeysEyebrow">Gjennom landskapet</p><h2 id="journeys-title" data-i18n="home.journeysTitle">Tre reiser inn i sagnene</h2></div></div><div class="journey-spotlights">{journeys.map(journey=><a class:list={['journey-spotlight',`journey-${journey.mode}`]} href={`${base}journey/#mode=${journey.mode}`}><div class="journey-scenery" aria-hidden="true">{journey.mode==='weave'&&<img src={threadsMeetPreview} alt="" loading="lazy" width="1470" height="711"/>}{journey.mode==='thread'&&<img src={oneThreadPreview} alt="" loading="lazy" width="1000" height="1000"/>}{journey.mode==='moe'&&<img src={livPhotograph} alt="" loading="lazy" width="1346" height="2048"/>}</div><div class="journey-story"><h3 data-i18n={`home.${journey.key}Title`}>{journey.title}</h3><p data-i18n={`home.${journey.key}Description`}>{journey.description}</p><span class="journey-open" data-i18n="home.beginJourney">Utforsk reisen</span></div></a>)}</div></section>
  <style>
    :global(body:has(.norske-home-hero)){background:var(--paper)!important}
    :global(body:has(.norske-home-hero)::before),:global(body:has(.norske-home-hero)::after){display:none!important}
    .hero.norske-home-hero{min-height:0;padding:3rem 0 2rem;background:var(--paper)!important;overflow:visible}
    .norske-home-hero::before,.norske-home-hero::after{display:none!important}
    .home-introduction{display:grid;grid-template-columns:1.05fr 1fr;gap:2rem;align-items:center}
    .home-copy{padding-bottom:1.5rem}.home-development{margin:0 0 1.3rem}.home-development .development-badge{font-size:.65rem;padding:.25rem .55rem}
    .home-copy .display{font-size:clamp(3.4rem,6.6vw,6rem);line-height:1.06;letter-spacing:-.045em;font-weight:400;margin-bottom:1.4rem}
    .home-copy .lede{max-width:35rem;font-size:1.12rem;line-height:1.8}.home-copy .hero-search{margin-top:1.8rem}.hero-actions{margin-top:1rem}
    .home-copy .hero-search input{background:var(--raised);color:var(--ink)}
    .home-copy .hero-search input::placeholder{color:var(--muted)}
    .norway-map{margin:0;min-width:0;justify-self:center;width:min(100%,550px)}
    .norway-map svg{display:block;width:100%;height:auto;max-height:550px;overflow:visible}
    .norway-outline{fill:color-mix(in srgb,var(--mist),transparent 87%);stroke:color-mix(in srgb,var(--blue),transparent 76%);stroke-width:.65;stroke-linejoin:round}
    .norway-lights circle{fill:color-mix(in srgb,var(--mist),var(--blue) 35%);opacity:.55}
    :global(:root[data-theme=dark]) .norway-lights circle{fill:var(--mist);opacity:.65}
    .norway-land-wash,.norway-light-wash{opacity:0;pointer-events:none;transition:opacity 1.4s ease}
    .norway-map.is-lit .norway-land-wash{opacity:.16}
    .norway-map.is-lit .norway-light-wash{opacity:.9}
    :global(:root[data-theme=dark]) .norway-map.is-lit .norway-land-wash{opacity:.09}
    .collection-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;margin-top:0;padding:1.8rem 0 2.4rem;border:0;background:transparent!important;box-shadow:none}
    .collection-summary .stat{display:block!important;min-height:0!important;padding:0!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;backdrop-filter:none!important;transform:none!important;text-align:left}
    .collection-summary .stat::before,.collection-summary .stat::after,.collection-summary .stat>:global(svg){display:none!important}
    .collection-summary .stat strong{display:block;margin:0;color:var(--ink)!important;font:400 clamp(2.4rem,4vw,3.4rem)/1.1 var(--serif);letter-spacing:-.04em;text-shadow:none!important}
    .collection-summary .stat span{display:block;margin:.45rem 0 0;color:var(--muted);font-size:.7rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase}
    .collection-summary .stat strong{transition:color .55s ease,transform .55s ease}
    .collection-summary .stat span{transition:color .55s ease}
    @media(hover:hover) and (pointer:fine){
      .collection-summary .stat:hover strong{color:color-mix(in srgb,var(--ink),var(--blue) 32%)!important;transform:translateY(-2px)}
      .collection-summary .stat:hover span{color:var(--blue)}
      :global(:root[data-theme=dark]) .collection-summary .stat:hover strong{color:color-mix(in srgb,var(--ink),var(--butter) 28%)!important}
    }
    .daily-section{padding-top:3rem;padding-bottom:3rem;border-top:1px solid var(--line);grid-template-columns:125px minmax(0,850px);gap:2.5rem}
    .daily-section .daily-icon{width:auto;min-height:0;align-self:start;border:0!important;background:transparent!important;box-shadow:none!important;transform:none!important;padding:.5rem 0}
    .daily-icon::before,.daily-icon::after{display:none!important}
    .daily-section .daily-icon{display:grid;grid-template-columns:24px 1fr;grid-template-rows:auto auto;column-gap:.55rem;row-gap:.5rem;align-items:center}
    .daily-section .daily-icon .calendar-mark{grid-column:1;grid-row:1;width:24px;height:24px;padding:0;background:transparent;border-radius:0;color:var(--blue)}
    .daily-section .daily-icon .calendar-label{grid-column:2;grid-row:1;align-self:center;color:var(--blue)}
    .daily-section .daily-icon time{grid-column:1/-1;grid-row:2;margin:0;font:400 .8rem/1.5 var(--sans);color:var(--muted);letter-spacing:.02em}
    :global(:root[data-theme=dark]) .daily-heading .eyebrow,
    :global(:root[data-theme=dark]) .home-journeys .eyebrow,
    :global(:root[data-theme=dark]) .home-topics .eyebrow,
    :global(:root[data-theme=dark]) .daily-section .daily-icon .calendar-mark,
    :global(:root[data-theme=dark]) .daily-section .daily-icon .calendar-label,
    :global(:root[data-theme=dark]) .daily-section .daily-icon time{color:var(--butter)}
    .home-topics{padding-top:3rem;padding-bottom:3.5rem;border-top:1px solid var(--line)}
    .home-topics h2{font:400 clamp(2rem,3.5vw,2.7rem)/1.2 var(--serif);letter-spacing:-.025em;color:#a67b12}
    :global(:root[data-theme=dark]) .home-topics h2{color:var(--butter)}
    .topic-blocks{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin-top:1.8rem}
    .topic-block{display:grid;grid-template-columns:28px minmax(0,1fr);grid-template-rows:minmax(3rem,auto) auto;column-gap:.85rem;align-items:start;position:relative;isolation:isolate;min-width:0;overflow:hidden;padding:1.15rem 1.2rem 1rem;border:1px solid color-mix(in srgb,var(--blue),transparent 91%);border-radius:18px;text-decoration:none;color:var(--ink);background:color-mix(in srgb,var(--mist),var(--paper) 91%);transition:transform .65s cubic-bezier(.2,.65,.3,1),border-color .65s ease,box-shadow .65s ease}
    .topic-block::before{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at var(--topic-x,20%) var(--topic-y,10%),#f3e1a0b3,transparent 80%);opacity:.22;transition:opacity .7s ease}
    .topic-block .topic-symbol{width:28px;height:28px;flex-shrink:0;color:var(--blue);margin:.1rem 0 0;opacity:.85;transition:transform .7s ease,opacity .7s ease,color .7s ease,filter .7s ease}
    .topic-block h3{font:400 1.2rem/1.3 var(--serif);letter-spacing:-.02em;margin:0;color:var(--ink)}
    .topic-totals{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin-top:.55rem;padding-top:.3rem;opacity:0;visibility:hidden;transform:translateY(4px);transition:opacity .35s ease,transform .45s ease,visibility .35s}
    .topic-totals>span{display:flex;flex-direction:column;gap:.3rem;min-width:0}
    .topic-totals strong{font:400 1.1rem/1.2 var(--serif);color:var(--ink)}
    .topic-totals span span{font-size:.63rem;line-height:1.5;color:var(--muted)}
    :global(:root[data-theme=dark]) .topic-block{border-color:#54759b45;background:linear-gradient(145deg,#253c57,#1b2b42 65%,#19253a)}
    :global(:root[data-theme=dark]) .topic-block::before{background:radial-gradient(ellipse at var(--topic-x,20%) var(--topic-y,10%),#b8d8ef30,transparent 75%);opacity:.35}
    :global(:root[data-theme=dark]) .topic-block .topic-symbol{color:#b9d6ef}
    :global(:root[data-theme=dark]) .topic-totals strong{color:#f3e1a0}
    :global(:root[data-theme=dark]) .topic-totals span span{color:#b7c9df}
    .topic-block:focus-visible{outline:2px solid var(--focus);outline-offset:4px}
    .topic-block:focus-visible .topic-totals{opacity:1;visibility:visible;transform:none}
    @media(hover:none), (pointer:coarse){.topic-totals{opacity:1;visibility:visible;transform:none}}
    @media(hover:hover) and (pointer:fine){
      .topic-block:hover{transform:translateY(-6px);border-color:#bf963d85;box-shadow:0 16px 35px #24324a18,0 3px 9px #24324a08}
      .topic-block:hover::before{opacity:1}
      .topic-block:hover .topic-totals{opacity:1;visibility:visible;transform:none}
      .topic-block:hover .topic-symbol{transform:scale(1.1);opacity:1;color:#936d13;filter:drop-shadow(0 0 9px #edd58d65)}
      :global(:root[data-theme=dark]) .topic-block:hover{border-color:#e9d18a9c;box-shadow:0 16px 35px #080e1c66,0 0 28px #83b7de15}
      :global(:root[data-theme=dark]) .topic-block:hover::before{opacity:1;background:radial-gradient(ellipse at var(--topic-x,20%) var(--topic-y,10%),#eddaad25,transparent 75%)}
      :global(:root[data-theme=dark]) .topic-block:hover .topic-symbol{color:var(--butter);filter:drop-shadow(0 0 11px #f3e1a035)}
    }
    @media(max-width:900px){.topic-blocks{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:600px){.home-topics{padding:2rem 0}.topic-blocks{gap:.85rem;margin-top:1.5rem}.topic-block{padding:1rem .85rem;grid-template-columns:1fr;grid-template-rows:auto;gap:.65rem}.topic-block .topic-symbol{width:26px;height:26px;margin:0}.topic-block h3{font-size:1.1rem}.topic-totals{grid-template-columns:1fr;gap:.5rem}.topic-totals>span{flex-direction:row;align-items:baseline;gap:.5rem}.topic-totals strong{font-size:1.05rem;min-width:2.1rem}.topic-totals span span{font-size:.69rem}}
    @media(max-width:360px){.topic-blocks{grid-template-columns:1fr}}
    @media(prefers-reduced-motion:reduce){.topic-block,.topic-block::before,.topic-block .topic-symbol,.topic-totals{transition:none}.topic-block:hover,.topic-block:hover .topic-symbol{transform:none}}
    .home-journeys{padding-top:3rem;padding-bottom:5rem;border-top:1px solid var(--line)}
    .home-journeys h2{font:400 clamp(2rem,3.5vw,2.7rem)/1.2 var(--serif);letter-spacing:-.025em}
    .journey-spotlights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.4rem;margin-top:2.5rem}
    .journey-spotlight{position:relative;isolation:isolate;display:flex;min-height:490px;align-items:end;overflow:hidden;border-radius:18px;text-decoration:none;color:#fcfaf6;background:#1c2836;transition:box-shadow .7s ease}
    .journey-scenery{position:absolute;inset:0;z-index:-2;overflow:hidden}.journey-scenery::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 10%,#14202d15 30%,#131e2ec9 61%,#121c2bf5 100%);z-index:2}
    .journey-scenery img{display:block;width:100%;height:100%;transition:transform 2s cubic-bezier(.2,.6,.3,1)}
    .journey-weave .journey-scenery img{object-position:51% 50%;filter:brightness(1.6)}
    .journey-thread .journey-scenery img{object-position:50% 50%;filter:brightness(1.15)}
    .journey-scenery img{object-fit:cover;object-position:50% 70%}.journey-moe .journey-scenery::after{background:linear-gradient(180deg,#352b1e08 25%,#29251e55 47%,#201e1cd9 70%,#1e1c1bf5 100%)}
    .journey-story{padding:2rem 1.8rem;width:100%}.journey-story h3{font:400 clamp(1.6rem,2.4vw,2.1rem)/1.15 var(--serif);margin:0 0 .9rem;letter-spacing:-.025em;color:#fcfaf6}.journey-story p{font-size:.86rem;line-height:1.75;color:#edece3d4;margin:0 0 1.4rem;min-height:4.6em}
    .journey-open{display:inline-block;font-size:.75rem;color:#f0dfb9;border-bottom:1px solid #f0dfb94d;padding-bottom:.3rem;transition:border-color .7s,color .7s}
    @media(hover:hover) and (pointer:fine){.journey-spotlight:hover img{transform:scale(1.035)}.journey-spotlight:hover .journey-open{border-color:#f0dfb9;color:#fff4d9}.journey-spotlight:hover{box-shadow:0 12px 30px #17182718}}
    .journey-spotlight:focus-visible{outline:3px solid var(--focus);outline-offset:5px}
    @media(max-width:850px){.home-introduction{gap:1rem;grid-template-columns:1.2fr 1fr}.home-copy .display{font-size:3.7rem}.norway-map svg{max-height:440px}.collection-summary{gap:1rem}.journey-spotlights{gap:1rem}.journey-story{padding:1.5rem 1.2rem}.journey-spotlight{min-height:460px}}
    @media(max-width:600px){.hero.norske-home-hero{padding-top:2rem}.home-introduction{grid-template-columns:1fr;gap:0}.home-copy{padding:0}.home-copy .display{font-size:3.9rem}.home-copy .lede{font-size:1rem}.norway-map{width:min(100%,340px);margin:1.5rem auto 0}.norway-map svg{max-height:350px}.collection-summary{grid-template-columns:repeat(2,1fr);gap:1.8rem 2rem;padding:1.5rem 0 2rem}.collection-summary .stat strong{font-size:2.5rem}.daily-section{grid-template-columns:1fr;gap:1rem;padding:2rem 0}.daily-section .daily-icon{display:grid;grid-template-columns:24px auto 1fr;grid-template-rows:auto;gap:.6rem;margin:0}.daily-section .daily-icon time{grid-column:3;grid-row:1;padding-left:.3rem}.daily-icon .calendar-mark{margin:0}.daily-icon .calendar-label{font-size:.7rem}.journey-spotlights{grid-template-columns:1fr;gap:1.25rem}.journey-spotlight{min-height:460px}.journey-story{padding:1.8rem}.journey-story p{min-height:0}.home-journeys{padding:2rem 0 3rem}}
    @media(prefers-reduced-motion:reduce){.norway-land-wash,.norway-light-wash,.journey-scenery img,.journey-open,.journey-spotlight,.collection-summary .stat strong,.collection-summary .stat span{transition:none} .collection-summary .stat:hover strong{transform:none}.journey-spotlight:hover img{transform:none}}
  </style>
  <script>
    const topicMotion=matchMedia('(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference)');
    document.querySelectorAll<HTMLElement>('.topic-block').forEach(card=>{card.addEventListener('pointermove',event=>{if(!topicMotion.matches)return;const rect=card.getBoundingClientRect();card.style.setProperty('--topic-x',`${(event.clientX-rect.left)/rect.width*100}%`);card.style.setProperty('--topic-y',`${(event.clientY-rect.top)/rect.height*100}%`)},{passive:true})});
    const refreshTopicCopy=()=>{const lang=document.documentElement.dataset.uiLang==='en'?'en':'no';document.querySelectorAll<HTMLElement>('[data-topic-copy]').forEach(element=>{element.textContent=element.dataset[lang]||element.dataset.no||''})};
    refreshTopicCopy();window.addEventListener('ui-language-change',refreshTopicCopy);
    const map=document.querySelector<HTMLElement>('.norway-map');
    const ambientMotion=matchMedia('(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference)');
    if(map){
      const svg=map.querySelector('svg')!,light=map.querySelector('radialGradient')!;
      let frame=0,previousTime=0,currentX=310,currentY=345,targetX=310,targetY=345;
      const drift=(now:number)=>{
        const elapsed=previousTime?Math.min(64,now-previousTime):16;previousTime=now;
        const ease=1-Math.exp(-elapsed/240);
        currentX+=(targetX-currentX)*ease;currentY+=(targetY-currentY)*ease;
        light.setAttribute('cx',String(currentX));light.setAttribute('cy',String(currentY));
        if(Math.hypot(targetX-currentX,targetY-currentY)>.15)frame=requestAnimationFrame(drift);else{frame=0;previousTime=0}
      };
      const locate=(event:PointerEvent)=>{const matrix=svg.getScreenCTM();if(!matrix)return;const point=new DOMPoint(event.clientX,event.clientY).matrixTransform(matrix.inverse());targetX=point.x;targetY=point.y};
      map.addEventListener('pointerenter',event=>{if(!ambientMotion.matches)return;locate(event);currentX=targetX;currentY=targetY;light.setAttribute('cx',String(currentX));light.setAttribute('cy',String(currentY));map.classList.add('is-lit')});
      map.addEventListener('pointermove',event=>{if(!ambientMotion.matches)return;locate(event);if(!frame)frame=requestAnimationFrame(drift)},{passive:true});
      const settle=()=>{map.classList.remove('is-lit');cancelAnimationFrame(frame);frame=0;previousTime=0};
      map.addEventListener('pointerleave',settle);ambientMotion.addEventListener('change',settle);
    }
    const dateElement=document.querySelector<HTMLTimeElement>('[data-daily-date]');
    const refreshDate=()=>{if(!dateElement)return;const now=new Date();dateElement.dateTime=new Intl.DateTimeFormat('sv-SE',{timeZone:'Europe/Oslo',year:'numeric',month:'2-digit',day:'2-digit'}).format(now);dateElement.textContent=new Intl.DateTimeFormat('nb-NO',{timeZone:'Europe/Oslo',day:'2-digit',month:'2-digit',year:'numeric'}).format(now)};
    refreshDate();setInterval(refreshDate,60000);document.addEventListener('visibilitychange',()=>{if(!document.hidden)refreshDate()});
    const counters=[...document.querySelectorAll<HTMLElement>('[data-count-up]')];
    const numberFormat=()=>new Intl.NumberFormat(document.documentElement.dataset.uiLang==='en'?'en-US':'nb-NO');
    const showFinal=()=>counters.forEach(counter=>counter.textContent=numberFormat().format(Number(counter.dataset.countUp||0)));
    const animateCounter=(counter:HTMLElement)=>{const target=Number(counter.dataset.countUp||0),started=performance.now(),duration=1100;const tick=(now:number)=>{const progress=Math.min((now-started)/duration,1),eased=1-Math.pow(1-progress,3);counter.textContent=numberFormat().format(Math.round(target*eased));if(progress<1)requestAnimationFrame(tick)};requestAnimationFrame(tick)};
    if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches&&'IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{if(!entries.some(entry=>entry.isIntersecting))return;observer.disconnect();counters.forEach((counter,index)=>window.setTimeout(()=>animateCounter(counter),index*90))},{threshold:.35});const summary=document.querySelector('.collection-summary');if(summary)observer.observe(summary)}else showFinal();
    window.addEventListener('ui-language-change',showFinal);
  </script>
</BaseLayout>
