---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ui from '../../i18n/ui.json';
import { mapData } from '../../map/data';
const sections = [
  { title: 'about.sourceTitle', paragraphs: ['about.source'], link: 'about.sourceLink', href: 'https://www2.hf.uio.no/eventyr_og_sagn/' },
  { title: 'about.samlaTitle', paragraphs: ['about.samlaUse', 'about.samla', 'about.samlaFuture'], link: 'about.samlaLink', href: 'https://samla.no/viewer/' }
];
const methods = [
 {id:'map-data',title:'about.mapDataTitle',paragraphs:['about.mapDataText','about.mapMissingText']},
 {id:'map-places',title:'about.placesMapTitle',paragraphs:['about.placesMapText']},
 {id:'map-legends',title:'about.legendMapTitle',paragraphs:['about.legendMapText','about.legendColorText']},
 {id:'map-clusters',title:'about.clusterMapTitle',paragraphs:['about.clusterMapText']},
 {id:'map-density',title:'about.densityMapTitle',paragraphs:['about.densityMapText','about.densityControlsText']},
 {id:'network',title:'about.networkTitle',paragraphs:['map.networkExplanation.plots','map.networkMetadataDetails','map.networkOverviewExplanation']},
 {id:'network-collectors',title:'about.collectorNetworkTitle',paragraphs:['about.collectorNetworkText','about.collectorNetworkScope']},
 {id:'network-colors',title:'about.networkColorsTitle',paragraphs:['about.networkColorsText','about.networkCategoriesText']},
 {id:'map-filters',title:'about.filtersTitle',paragraphs:['about.filtersText']},
 {id:'browse-selection',title:'about.browseSelectionTitle',paragraphs:['about.browseSelectionText','about.browseActionsText']},
 {id:'exports',title:'about.exportsTitle',paragraphs:['about.exportsText']},
];
const coverage = [{key:'about.totalRecords',count:mapData.legends.features.length+mapData.unmappedLegends.length},{key:'about.mappedRecords',count:mapData.legends.features.length},{key:'about.unmappedRecords',count:mapData.unmappedLegends.length}];
const copy = (key: string) => ui[key as keyof typeof ui].no;
---
<BaseLayout active="about" title="Om prosjektet" description="About Norske sagn: the original UiO collection, Kyrre Kverndokk, archival materials from SAMLA, and development by the University of Latvia Digital Humanities Center.">
  <div class="shell about-shell about-page">
    <header class="about-heading">
      <h1 data-i18n="nav.about">Om prosjektet</h1>
      <p class="lede"><span data-i18n="about.intro">{copy('about.intro')}</span>{' '}<span data-i18n="about.development">{copy('about.development')}</span></p>
    </header>
    <div class="about-main">
      {sections.map(section => <section aria-labelledby={section.title}>
        <h2 id={section.title} data-i18n={section.title}>{copy(section.title)}</h2>
        {section.paragraphs.map(key => <p data-i18n={key}>{copy(key)}</p>)}
        <a class="icon-link about-link" href={section.href} target="_blank" rel="noopener noreferrer"><span data-i18n={section.link}>{copy(section.link)}</span><i data-lucide="external-link"></i></a>
      </section>)}
      <section aria-labelledby="about-developer">
        <h2 id="about-developer" data-i18n="about.developerTitle">{copy('about.developerTitle')}</h2>
        <p><span data-i18n="about.developerBefore">{copy('about.developerBefore')}</span>{' '}<a href="https://dhc.lu.lv/" target="_blank" rel="noopener noreferrer" data-i18n="about.developerLink">{copy('about.developerLink')}</a>.</p>
        <p><span data-i18n="about.openSource">{copy('about.openSource')}</span>{' '}<a href="https://github.com/ul-dhc/norwegian-folk-legends" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
      </section>
      <section aria-labelledby="about-contact">
        <h2 id="about-contact" data-i18n="about.contactTitle">{copy('about.contactTitle')}</h2>
        <ul class="about-contacts">
          <li><span>Sanita Reinsone</span><a class="about-link" href="mailto:sanita.reinsone@lu.lv">sanita.reinsone@lu.lv</a></li>
          <li><span>Kyrre Kverndokk</span><a class="about-link" href="mailto:kyrre.kverndokk@uib.no">kyrre.kverndokk@uib.no</a></li>
        </ul>
      </section>
    <nav class="about-contents" aria-label={copy('about.contents')}><strong data-i18n="about.methodsTitle">{copy('about.methodsTitle')}</strong><ul>{methods.map(section=><li><a href={`#${section.id}`} data-i18n={section.title}>{copy(section.title)}</a></li>)}</ul></nav>
      {methods.map(section=><section id={section.id} aria-labelledby={`${section.id}-title`}>
        <h2 id={`${section.id}-title`} data-i18n={section.title}>{copy(section.title)}</h2>
        {section.id==='map-data'&&<dl class="about-coverage">{coverage.map(item=><div><dt data-i18n={item.key}>{copy(item.key)}</dt><dd>{item.count.toLocaleString('no-NO')}</dd></div>)}</dl>}
        {section.paragraphs.map(key=><p data-i18n={key}>{copy(key)}</p>)}
      </section>)}
    </div>
  </div>
  <style>
    .about-page{padding-block:clamp(2.5rem,6vw,5rem) clamp(3rem,7vw,6rem)}
    .about-contents{max-width:820px;padding:1.5rem 0;border-bottom:1px solid var(--line);color:var(--muted)}
    .about-contents strong{font-weight:500;color:var(--ink)}
    .about-contents ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem 1.5rem;list-style:none;padding:0;margin:1rem 0 0}
    .about-contents a{color:var(--blue);text-underline-offset:.2em;font-size:.9rem}
    .about-main section[id]{scroll-margin-top:1.5rem}
    .about-main section:target h2{color:var(--pin)}
    .about-coverage{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.5rem 0}
    .about-coverage dt{font-size:.8rem;color:var(--muted);line-height:1.5}
    .about-coverage dd{margin:.4rem 0 0;font-size:1.8rem;color:var(--blue);font-variant-numeric:tabular-nums}
    @media(max-width:600px){.about-contents ul{grid-template-columns:1fr}.about-coverage{gap:.6rem}.about-coverage dd{font-size:1.5rem}}
    .about-heading{max-width:820px;padding-bottom:2rem;border-bottom:1px solid var(--line)}
    .about-contacts{list-style:none;padding:0;margin:1.25rem 0 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}
    .about-contacts li{display:grid;gap:.65rem}
    h1{margin:0 0 1.25rem;font:400 clamp(2.8rem,6vw,4.5rem)/1.1 var(--serif);letter-spacing:-.035em}
    .about-heading .lede{margin:0;max-width:44rem}
    .about-main section{padding-bottom:2rem;border-bottom:1px solid var(--line)}
    .about-main section h2{transition:color .3s ease}
    .about-main section:focus-within h2{color:#94721d}
    :global(:root[data-theme=dark]) .about-main section:focus-within h2{color:var(--butter)}
    @media(hover:hover) and (pointer:fine){
      .about-main section:hover h2{color:#94721d}
      :global(:root[data-theme=dark]) .about-main section:hover h2{color:var(--butter)}
    }
    @media(prefers-reduced-motion:reduce){.about-main section h2{transition:none}}
    .about-main section:last-child{padding-bottom:0;border-bottom:0}
    .about-main h2{margin-top:2rem}
    .about-link{font-size:.9rem;color:var(--blue);text-underline-offset:.25em;overflow-wrap:anywhere}
    .about-link:hover{color:var(--ink)}
    .about-link :global(svg){flex-shrink:0}
    @media(max-width:600px){.about-main{font-size:1rem}.about-link{align-items:baseline}.about-link :global(svg){align-self:center}}
  </style>
</BaseLayout>
