---
import ui from '../../i18n/ui.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { types, topics } from '../../ml-index/data';
import '../../ml-index/style.css';
import '../../styles/data-workspace.css';
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Data" active="data" description="Explore the Norwegian folk legend collection through interactive statistics and selected texts.">
 <div class="ml-page ml-data-page shell" data-i18n-skip>
  <header class="ml-hero"><h1>Data</h1></header>
  <nav class="data-overview-tabs" aria-label="Datavisninger"><a href="?view=network#network" data-data-view="network"><i data-lucide="network"></i><span data-network-tab>Nettverk</span></a><a href="?view=overview#overview" data-data-view="overview"><i data-lucide="chart-no-axes-column"></i><span data-overview-tab>Oversikt</span></a></nav>
  <section id="ml-dashboard" aria-labelledby="ml-dashboard-title"><div id="ml-dashboard-content"></div></section>
  <div class="data-help-footer"><a class="context-help" href={`${base}about/#guide-data`} target="_blank" rel="noopener"><i data-lucide="info"></i><span data-data-guide-link>{ui['about.dataGuideLink'].no}</span></a></div>
  <noscript><p>Statistikken krever JavaScript. / The dashboard requires JavaScript.</p></noscript>
 </div>
 <script type="application/json" id="ml-data" is:inline set:html={JSON.stringify({types,topics,base}).replace(/</g,'\\u003c')}/>
 <script>import '../../ml-index/data-main'; import ui from '../../i18n/ui.json'; const updateGuideLabel=()=>{const en=document.documentElement.dataset.uiLang==='en';document.querySelector('[data-overview-tab]')!.textContent=en?'Overview':'Oversikt';document.querySelector('[data-network-tab]')!.textContent=en?'Network':'Nettverk';document.querySelector('.data-overview-tabs')!.setAttribute('aria-label',en?'Data views':'Datavisninger');const label=document.querySelector('[data-data-guide-link]');if(label)label.textContent=ui['about.dataGuideLink'][document.documentElement.dataset.uiLang==='en'?'en':'no'];};updateGuideLabel();window.addEventListener('ui-language-change',updateGuideLabel);</script>
</BaseLayout>
