---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { legends, resolveLegend, legendYear, displayPersonName, type Legend } from '../../lib/data';
const base = import.meta.env.BASE_URL;
export function getStaticPaths() { return legends.map((legend, index) => ({ params: { id: legend.id }, props: { legend, index } })); }
const { legend, index } = Astro.props as { legend: Legend; index: number };
const data = resolveLegend(legend), previous = legends[index - 1], next = legends[index + 1], year = legendYear(legend);
const hasTranslation = Boolean(legend.text.en?.trim());
const missingValue = '—';
const basicRows = [['', 'ID', legend.id], ['meta.place', 'Sted', data.place?.name || missingValue], ['meta.county', 'Fylke', data.county?.name || missingValue], ['meta.informant', 'Informant', displayPersonName(data.narrator) || missingValue], ['meta.collector', 'Samler', displayPersonName(data.collector) || missingValue], ['meta.year', 'År', year || missingValue]];
const publicUrl = new URL(`${base}legends/${legend.id}/`, Astro.site ?? Astro.url.origin).href;
const narratorName = displayPersonName(data.narrator), collectorName = displayPersonName(data.collector);
const trimPeriod = (value: string) => value.replace(/[.\s]+$/,'');
const sourceReference = legend.sourceUrl || publicUrl;
const shortCitation = `${legend.title.no ? `${trimPeriod(legend.title.no)}. ` : ''}Norske sagn, ID ${legend.id}. ${sourceReference}`;
const extendedCitation = [
  legend.title.no ? `${trimPeriod(legend.title.no)}.` : '',
  `Norske sagn, ID ${legend.id}.`,
  legend.mlCategoryId && data.category ? `ML category: ${data.category.code}${data.category.title ? ` (${trimPeriod(data.category.title)})` : ''}.` : '',
  narratorName ? `Informant: ${trimPeriod(narratorName)}.` : '',
  collectorName ? `Collector: ${trimPeriod(collectorName)}.` : '',
  data.place?.name ? `Place: ${data.place.name}.` : '',
  data.county?.name ? `County: ${data.county.name}.` : '',
  year ? `Year: ${year}.` : '',
  legend.archiveSignature ? `Archive signature: ${trimPeriod(legend.archiveSignature)}.` : '',
  legend.textSignature && legend.textSignature !== legend.archiveSignature ? `Text signature: ${trimPeriod(legend.textSignature)}.` : '',
  `Digital source: ${sourceReference}`,
  `Explorer record: ${publicUrl}`,
].filter(Boolean).join(' ');
const shareMetadata = [
  `ID: ${legend.id}.`,
  data.place?.name ? `Place: ${data.place.name}.` : '',
  data.county?.name ? `County: ${data.county.name}.` : '',
  year ? `Year: ${year}.` : '',
  narratorName ? `Informant: ${narratorName.replace(/[.\s]+$/,'')}.` : '',
  collectorName ? `Collector: ${collectorName.replace(/[.\s]+$/,'')}.` : '',
  data.category ? `ML category: ${[data.category.code,data.category.title].filter(Boolean).join(' · ')}.` : '',
  legend.sourceUrl ? `Digital source: ${legend.sourceUrl}` : '',
].filter(Boolean).join(' ');
const additionalRows=[
  {key:'meta.theme',label:'ML-kategori',value:legend.chapter.no||missingValue},
  {key:'meta.genre',label:'Sjanger',value:legend.genre||missingValue},
  {key:'meta.subgenre',label:'Undersjanger',value:legend.subgenre||missingValue},
  {key:'meta.archive',label:'Arkivsignatur',value:legend.archiveSignature||missingValue},
  {key:'meta.textSignature',label:'Tekstsignatur',value:legend.textSignature||missingValue},
];
const lvShareText = [legend.title.no || 'Uten tittel', legend.text.no || 'Tekst mangler.', shareMetadata, publicUrl].join('\n\n');
const deShareText = [legend.title.en || 'Untitled', legend.text.en || 'Translation unavailable.', shareMetadata, publicUrl].join('\n\n');
const parallelShareText = [legend.title.no || 'Uten tittel', 'Norwegian', legend.text.no || 'Tekst mangler.', legend.title.en || 'Untitled', 'English', legend.text.en || 'Translation unavailable.', shareMetadata, publicUrl].join('\n\n');
---
<BaseLayout title={legend.title.no || legend.id} active="browse">
  <article class="detail" data-has-translation={String(hasTranslation)}>
    <div class="detail-top"><a class="back-link icon-link" href={`${base}browse/`} data-back><i data-lucide="arrow-left"></i> Tilbake</a><div class="detail-actions"><button class="copy-icon detail-pin" type="button" data-detail-pin={legend.id} aria-pressed="false" aria-label="Fest sagn" title="Fest sagn"><i data-lucide="pin"></i></button><button class="copy-icon" type="button" data-copy-link={publicUrl} aria-label="Kopier lenke" title="Kopier lenke"><i data-lucide="link"></i></button><button class="copy-icon" type="button" data-copy data-copy-no={lvShareText} data-copy-en={deShareText} data-copy-parallel={parallelShareText} aria-label="Kopier sagn" title="Kopier sagn"><i data-lucide="copy"></i></button><div class="citation-control"><button class="copy-icon citation-toggle" type="button" data-citation-toggle aria-expanded="false" aria-controls="citation-panel" aria-label="Siter sagn" title="Siter sagn"><i data-lucide="quote"></i></button><section class="citation-panel" id="citation-panel" data-citation-panel hidden aria-labelledby="citation-title"><div class="citation-panel-head"><h2 id="citation-title" data-i18n="detail.citation">Sitering</h2><button type="button" class="citation-close" data-citation-close aria-label="Lukk sitering"><i data-lucide="x"></i></button></div><article><h3 data-i18n="detail.shortCitation">Kort referanse</h3><p>{shortCitation}</p><button type="button" class="citation-copy" data-citation-copy={shortCitation}><i data-lucide="copy"></i><span data-i18n="common.copy">Kopier</span></button></article><article><h3 data-i18n="detail.extendedCitation">Utvidet referanse</h3><p>{extendedCitation}</p><button type="button" class="citation-copy" data-citation-copy={extendedCitation}><i data-lucide="copy"></i><span data-i18n="common.copy">Kopier</span></button></article></section></div></div></div>
    <header class="title-row"><div><h1 data-title-lang="no">{legend.title.no || 'Uten tittel'}</h1>{legend.title.en && <h1 data-title-lang="en" lang="en">{legend.title.en}</h1>}</div></header>
    <div class="mode-tabs" role="tablist" aria-label="Tekstvisning"><button role="tab" data-mode="no" data-i18n="text.norwegian">Norsk</button>{hasTranslation && <button role="tab" data-mode="en" data-i18n="text.english">Engelsk</button>}{hasTranslation && <button role="tab" data-mode="parallel" data-i18n="text.parallel">Parallelt</button>}</div>
    <div class="detail-grid">
      <div class="reading-column">
        <div class="texts" data-texts><section class="text-panel" data-lang="no" aria-labelledby="no-heading"><h2 id="no-heading" data-i18n="text.original">NORSK ORIGINAL</h2><div class="legend-text">{legend.text.no || 'Tekst mangler.'}</div></section>{hasTranslation && <section class="text-panel" data-lang="en" lang="en" aria-labelledby="en-heading"><h2 id="en-heading" data-i18n="text.translation">ENGELSK OVERSETTELSE</h2><div class="legend-text">{legend.text.en}</div></section>}</div>
        <details class="information" data-information open><summary><span><span data-i18n="detail.information">Informasjon</span><small data-i18n="detail.infoHelp">om sagnet og kilden</small></span><i data-lucide="chevron-down"></i></summary><div class="information-body"><dl>{basicRows.map(([key,label,value]) => <div class="metadata-row"><dt data-i18n={key || undefined}>{label}</dt><dd>{value}</dd></div>)}</dl><details class="more-metadata"><summary><span data-i18n="detail.moreMetadata">Flere metadata</span><i data-lucide="chevron-down"></i></summary><dl>{additionalRows.map(row=><div class="metadata-row"><dt data-i18n={row.key}>{row.label}</dt><dd>{row.value}</dd></div>)}<div class="metadata-row"><dt data-i18n="meta.source">Digital kilde</dt><dd><a href={legend.sourceUrl || publicUrl} target="_blank" rel="noopener noreferrer">{legend.sourceUrl ? 'University of Oslo' : 'Norske sagn'}</a></dd></div></dl></details></div></details>
        {(legend.comments || legend.notes) && <aside class="editorial" aria-label="Redaksjonell informasjon">{legend.comments && <details><summary>Redaktørkommentar</summary><p>{legend.comments}</p></details>}{legend.notes && <details><summary>Redaksjonelle merknader</summary><p>{legend.notes}</p></details>}</aside>}
        <nav class="prev-next" aria-label="Nabosagn" data-prev-next data-current-id={legend.id}><a href={previous ? `${base}legends/${previous.id}/` : '#'} data-previous hidden={!previous}><span class="nav-direction"><i data-lucide="arrow-left"></i> Forrige sagn</span><span class="legend-nav-title">{previous ? (previous.title.no || previous.title.en || previous.id) : ''}</span></a><a href={next ? `${base}legends/${next.id}/` : '#'} data-next hidden={!next}><span class="nav-direction">Neste sagn <i data-lucide="arrow-right"></i></span><span class="legend-nav-title">{next ? (next.title.no || next.title.en || next.id) : ''}</span></a></nav>
      </div>
    </div>
  </article>
  <script>
    const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-mode]')],panels=[...document.querySelectorAll<HTMLElement>('[data-lang]')],titles=[...document.querySelectorAll<HTMLElement>('[data-title-lang]')],texts=document.querySelector<HTMLElement>('[data-texts]')!;
    const syncChapterMeta=(_mode:string)=>{};
    const hasTranslation=document.querySelector<HTMLElement>('.detail')?.dataset.hasTranslation==='true';let currentMode=hasTranslation?(document.documentElement.dataset.contentMode||'parallel'):'no';
    const hashForMode=(mode:string)=>mode==='parallel'?'no-en':mode;
    const modeFromHash=()=>location.hash==='#no'?'no':location.hash==='#en'?'en':location.hash==='#no-en'?'parallel':null;
    function setMode(mode:string,updateHash=false){if(!hasTranslation)mode='no';currentMode=mode;document.documentElement.dataset.contentMode=mode;localStorage.setItem('norske-content-mode',mode);tabs.forEach(t=>t.setAttribute('aria-selected',String(t.dataset.mode===mode)));panels.forEach(p=>p.hidden=mode!=='parallel'&&p.dataset.lang!==mode);titles.forEach(t=>t.hidden=mode!=='parallel'&&t.dataset.titleLang!==mode);texts.classList.toggle('single',mode!=='parallel');syncChapterMeta(mode);if(updateHash)history.replaceState(null,'',`#${hashForMode(mode)}`)}
    tabs.forEach(t=>{t.addEventListener('click',()=>setMode(t.dataset.mode!,true));t.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const i=tabs.indexOf(t);tabs[(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length].focus()}})});setMode(modeFromHash()||document.documentElement.dataset.contentMode||'parallel');window.addEventListener('hashchange',()=>{const hashMode=modeFromHash();if(hashMode)setMode(hashMode)});
    window.addEventListener('content-mode-change',(event)=>setMode((event as CustomEvent).detail));
    async function copyText(text:string){try{await navigator.clipboard.writeText(text)}catch{const area=document.createElement('textarea');area.value=text;area.style.position='fixed';area.style.opacity='0';document.body.append(area);area.select();document.execCommand('copy');area.remove()}}
    function showCopied(button:HTMLButtonElement,restoreIcon='copy'){const icon=button.querySelector<HTMLElement>('[data-lucide]')!,label=button.querySelector<HTMLElement>('span'),oldLabel=label?.textContent||'';button.classList.add('copied');icon.dataset.lucide='check';if(label)label.textContent='Kopiert';(window as any).renderLucideIcons?.();setTimeout(()=>{button.classList.remove('copied');icon.dataset.lucide=restoreIcon;if(label)label.textContent=oldLabel;(window as any).renderLucideIcons?.()},1800)}
    document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click',async(e)=>{const button=e.currentTarget as HTMLButtonElement,text=currentMode==='no'?button.dataset.copyNo:currentMode==='en'?button.dataset.copyEn:button.dataset.copyParallel,tr=(key:string)=>(window as any).teikasT?.(key)||key;await copyText(text||'');button.setAttribute('aria-label',tr('detail.copied'));showCopied(button);setTimeout(()=>button.setAttribute('aria-label',tr('detail.copy')),1800)});
    document.querySelector<HTMLButtonElement>('[data-copy-link]')?.addEventListener('click',async event=>{const button=event.currentTarget as HTMLButtonElement,tr=(key:string)=>(window as any).teikasT?.(key)||key;await copyText(button.dataset.copyLink||location.href);button.setAttribute('aria-label',tr('detail.copied'));showCopied(button,'link');setTimeout(()=>button.setAttribute('aria-label',tr('detail.copyLink')),1800)});
    const detailPin=document.querySelector<HTMLButtonElement>('[data-detail-pin]')!;const readPins=()=>{try{return new Set<string>(JSON.parse(localStorage.getItem('norske-pins')||'[]'))}catch{return new Set<string>()}};const syncDetailPin=()=>{const pinned=readPins().has(detailPin.dataset.detailPin!);detailPin.setAttribute('aria-pressed',String(pinned));const label=(window as any).teikasT?.(pinned?'browser.unpin':'browser.pin')||(pinned?'Fjern feste fra sagn':'Fest sagn');detailPin.setAttribute('aria-label',label);detailPin.title=label};detailPin.addEventListener('click',()=>{const pins=readPins(),id=detailPin.dataset.detailPin!;pins.has(id)?pins.delete(id):pins.add(id);localStorage.setItem('norske-pins',JSON.stringify([...pins]));syncDetailPin()});window.addEventListener('ui-language-change',syncDetailPin);window.addEventListener('storage',event=>{if(event.key==='norske-pins')syncDetailPin()});syncDetailPin();
    const citationToggle=document.querySelector<HTMLButtonElement>('[data-citation-toggle]')!,citationPanel=document.querySelector<HTMLElement>('[data-citation-panel]')!;const setCitationOpen=(open:boolean)=>{citationPanel.hidden=!open;citationToggle.setAttribute('aria-expanded',String(open))};citationToggle.addEventListener('click',event=>{event.stopPropagation();setCitationOpen(citationPanel.hasAttribute('hidden'))});document.querySelector('[data-citation-close]')?.addEventListener('click',()=>setCitationOpen(false));document.querySelectorAll<HTMLButtonElement>('[data-citation-copy]').forEach(button=>button.addEventListener('click',async()=>{await copyText(button.dataset.citationCopy||'');showCopied(button)}));citationPanel.addEventListener('click',event=>event.stopPropagation());document.addEventListener('click',()=>setCitationOpen(false));document.addEventListener('keydown',event=>{if(event.key==='Escape')setCitationOpen(false)});
    document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click',e=>{if(document.referrer.startsWith(location.origin)){e.preventDefault();history.back()}});
    type BrowseNeighbour={id:string;titleNo:string;titleEn:string};const neighbourNav=document.querySelector<HTMLElement>('[data-prev-next]');const browseNeighbours=(()=>{try{return JSON.parse(sessionStorage.getItem('norske-browse-results')||'[]') as BrowseNeighbour[]}catch{return[] as BrowseNeighbour[]}})();const neighbourIndex=browseNeighbours.findIndex(item=>item.id===neighbourNav?.dataset.currentId);const neighbourTitle=(item:BrowseNeighbour)=>currentMode==='en'?(item.titleEn||item.titleNo||item.id):(item.titleNo||item.titleEn||item.id);const setNeighbour=(selector:string,item:BrowseNeighbour|undefined)=>{const anchor=neighbourNav?.querySelector<HTMLAnchorElement>(selector);if(!anchor)return;anchor.hidden=!item;if(!item)return;anchor.href=`${import.meta.env.BASE_URL}legends/${item.id}/`;const title=anchor.querySelector<HTMLElement>('.legend-nav-title');if(title)title.textContent=neighbourTitle(item)};const syncNeighbours=()=>{if(neighbourIndex<0)return;setNeighbour('[data-previous]',browseNeighbours[neighbourIndex-1]);setNeighbour('[data-next]',browseNeighbours[neighbourIndex+1])};syncNeighbours();tabs.forEach(tab=>tab.addEventListener('click',syncNeighbours));window.addEventListener('content-mode-change',syncNeighbours);
    const info=document.querySelector<HTMLDetailsElement>('[data-information]')!,mobile=matchMedia('(max-width: 850px)');const arrangeInfo=(event:MediaQueryList|MediaQueryListEvent)=>{info.open=!event.matches};arrangeInfo(mobile);mobile.addEventListener('change',arrangeInfo);
  </script>
</BaseLayout>
