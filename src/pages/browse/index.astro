    function syncYears(){if(+yearFrom.value>+yearTo.value)[yearFrom.value,yearTo.value]=[yearTo.value,yearFrom.value];const fromOutput=root.querySelector<HTMLElement>('[data-year-from]')!,toOutput=root.querySelector<HTMLElement>('[data-year-to]')!;fromOutput.textContent=yearFrom.value;toOutput.textContent=yearTo.value;const fromChanged=yearFrom.value!==yearFrom.min,toChanged=yearTo.value!==yearTo.max;fromOutput.classList.toggle('is-changed',fromChanged);toOutput.classList.toggle('is-changed',toChanged);timeline.classList.toggle('is-active',fromChanged||toChanged);const min=+yearFrom.min,max=+yearFrom.max,left=((+yearFrom.value-min)/(max-min))*100,right=100-((+yearTo.value-min)/(max-min))*100;root.querySelector<HTMLElement>('.range-track')!.style.setProperty('--range-left',`${left}%`);root.querySelector<HTMLElement>('.range-track')!.style.setProperty('--range-right',`${right}%`)}const syncSearchHelp=()=>{searchHelp.hidden=!q.value.trim()};let rangeFrame=0,searchTimer=0,isComposing=false;root.querySelector('[data-controls]')!.addEventListener('input',event=>{if((event.target as HTMLElement).closest('[data-multi-filter]'))return;syncYears();page=1;if((event.target as HTMLInputElement).type==='range'){cancelAnimationFrame(rangeFrame);rangeFrame=requestAnimationFrame(()=>render())}else render()});q.addEventListener('compositionstart',()=>isComposing=true);q.addEventListener('compositionend',()=>{isComposing=false;window.clearTimeout(searchTimer);page=1;render()});q.addEventListener('input',()=>{syncSearchHelp();if(isComposing)return;window.clearTimeout(searchTimer);searchTimer=window.setTimeout(()=>{page=1;render()},180)});mobileFilterToggle.addEventListener('click',()=>{const open=!filterSidebar.classList.contains('filters-open');filterSidebar.classList.toggle('filters-open',open);mobileFilterToggle.setAttribute('aria-expanded',String(open))});root.querySelectorAll<HTMLButtonElement>('[data-text-mode]').forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.textMod