import BaseLayout from '../../layouts/BaseLayout.astro';
import { browseRecords, volumes } from '../../lib/data';
const base = import.meta.env.BASE_URL;
const people = [...new Set(browseRecords.map(r=>r.narrator).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'no'));
const collectorPeople = [...new Set(browseRecords.map(r=>r.collector).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'no'));
const placeNames = [...new Set(browseRecords.map(r=>r.place).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'no'));
const years = browseRecords.map(r=>Number(r.year)).filter(Boolean); const minYear=Math.min(...years), maxYear=Math.max(...years);
const undatedCount = browseRecords.filter(r=>!r.year).length;
const undatedPercent = Math.round((undatedCount / browseRecords.length) * 100);
const chapterOptions = [...new Map(browseRecords.filter(r=>r.chapterNo).map(r=>[r.chapterNo,{no:r.chapterNo,en:r.chapterEn||r.chapterNo}])).values()].sort((a,b)=>a.no.localeCompare(b.no,'no'));
const unknownPersonValue = '__unknown__';
---
<BaseLayout title="Utforsk sagn" active="browse">
  <header class="browse-hero compact"><div class="shell"><a class="back-link icon-link" href={base}><i data-lucide="arrow-left"></i> Tilbake</a><h1>Utforsk sagn</h1><p class="lede">Søk, utforsk og fest sagn du vil vende tilbake til.</p></div></header>
  <section class="shell browser-layout browser" data-browser>
    <aside class="filter-sidebar"><button class="mobile-filter-toggle" type="button" data-mobile-filter-toggle aria-expanded="false" aria-controls="browse-filters"><span><i data-lucide="sliders-horizontal"></i> Filtre</span><i data-lucide="chevron-down"></i></button><form data-controls id="browse-filters"><div class="filter-title"><h2>Filtre</h2><button class="text-button clear-filters" type="button" data-clear hidden><i data-lucide="rotate-ccw"></i> Nullstill filtre</button></div>
      <details class="multi-select" data-multi-filter="theme"><summary><span>ML-kategorier</span><small data-filter-count="theme">Visas</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchThemes">Søk i ML-kategorier</span><input type="search" placeholder="Søk i ML-kategorier…" data-i18n-placeholder="map.searchThemes" data-filter-search="theme" /></label><div class="multi-actions"><button type="button" data-filter-select-all data-i18n="map.selectAll">Velg alle</button><button type="button" data-filter-clear-all data-i18n="map.clearAll">Fjern alle</button></div><div class="multi-options" data-filter-options="theme">{chapterOptions.map(v=><label data-option={v.no}><input type="checkbox" value={v.no} checked /> <span data-option-no={v.no} data-option-en={v.en}>{v.no}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="narrator"><summary><span>Informanter</span><small data-filter-count="narrator">Visi</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchNarrators">Søk etter informant</span><input type="search" placeholder="Søk etter informant…" data-i18n-placeholder="map.searchNarrators" data-filter-search="narrator" /></label><div class="multi-actions"><button type="button" data-filter-select-all data-i18n="map.selectAll">Velg alle</button><button type="button" data-filter-clear-all data-i18n="map.clearAll">Fjern alle</button></div><div class="multi-options" data-filter-options="narrator"><label data-option={unknownPersonValue}><input type="checkbox" value={unknownPersonValue} checked /> <span data-i18n="map.unknownNarrators">Ukjente informanter</span></label>{people.map(v=><label data-option={v}><input type="checkbox" value={v} checked /> <span>{v}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="collector"><summary><span>Samlere</span><small data-filter-count="collector">Visi</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchCollectors">Søk etter samler</span><input type="search" placeholder="Søk etter samler…" data-i18n-placeholder="map.searchCollectors" data-filter-search="collector" /></label><div class="multi-actions"><button type="button" data-filter-select-all data-i18n="map.selectAll">Velg alle</button><button type="button" data-filter-clear-all data-i18n="map.clearAll">Fjern alle</button></div><div class="multi-options" data-filter-options="collector"><label data-option={unknownPersonValue}><input type="checkbox" value={unknownPersonValue} checked /> <span data-i18n="map.unknownCollectors">Ukjente samlere</span></label>{collectorPeople.map(v=><label data-option={v}><input type="checkbox" value={v} checked /> <span>{v}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="place"><summary><span>Steder</span><small data-filter-count="place">Visas</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only">Søk etter sted</span><input type="search" placeholder="Søk etter sted…" data-filter-search="place" /></label><div class="multi-actions"><button type="button" data-filter-select-all>Velg alle</button><button type="button" data-filter-clear-all>Fjern alle</button></div><label class="unknown-toggle"><input id="include-unknown-place" type="checkbox" checked /> <span>Inkluder ukjente steder</span></label><div class="multi-options" data-filter-options="place">{placeNames.map(v=><label data-option={v}><input type="checkbox" value={v} checked /> <span>{v}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="volume"><summary><span>Undersjangre</span><small data-filter-count="volume">Visi</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchVolumes">Søk etter undersjanger</span><input type="search" placeholder="Søk etter undersjanger…" data-i18n-placeholder="map.searchVolumes" data-filter-search="volume" /></label><div class="multi-actions"><button type="button" data-filter-select-all data-i18n="map.selectAll">Velg alle</button><button type="button" data-filter-clear-all data-i18n="map.clearAll">Fjern alle</button></div><div class="multi-options" data-filter-options="volume">{volumes.map(v=><label data-option={v}><input type="checkbox" value={v} checked /> <span>{v}</span></label>)}</div></div></details>
      <fieldset class="timeline"><legend>Innsamlingsår</legend><div class="timeline-values"><output data-year-from>{minYear}</output><span>–</span><output data-year-to>{maxYear}</output></div><div class="dual-range"><span class="range-track" aria-hidden="true"></span><input id="year-from" type="range" min={minYear} max={maxYear} value={minYear}/><input id="year-to" type="range" min={minYear} max={maxYear} value={maxYear}/></div><label class="undated-toggle"><input id="include-undated" type="checkbox" checked /><span>Inkluder udaterte sagn</span><small>{undatedPercent}% · {undatedCount.toLocaleString('no-NO')} udaterte sagn</small></label></fieldset>
    </form></aside>
    <button class="browse-filter-collapse" type="button" data-filter-collapse aria-expanded="true" aria-controls="browse-filters" aria-label="Skjul filtre" title="Skjul filtre"><i class="filter-collapse-icon" data-lucide="sliders-horizontal" aria-hidden="true"></i><span data-filter-collapse-label>Skjul filtre</span><i class="filter-collapse-chevron" data-lucide="chevron-left" aria-hidden="true"></i></button>
    <div class="browser-main"><div class="browser-top"><div class="field search-field"><label class="sr-only" for="q">Søk</label><input id="q" name="q" type="search" autocomplete="off" placeholder="Søk i tekst, tittel, person eller sted…" aria-describedby="search-help" /><small class="search-help" id="search-help" hidden>Bruk anførselstegn for å søke etter en eksakt frase.</small></div><div class="content-language"><span>Tekstspråk</span><div class="view-switch"><button data-text-mode="no">NO</button><button data-text-mode="en">EN</button><button data-text-mode="parallel">NO &amp; EN</button></div></div></div>
      <div class="active-filters" data-active-filters hidden aria-label="Aktive filtre"></div><div class="browser-toolbar"><div class="result-summary"><span data-result-count-label>20 no <span data-count>{browseRecords.length.toLocaleString('no-NO')}</span> resultater</span><span class="page-label" data-page-label></span><button class="clear-pins" type="button" data-clear-pins hidden><i data-lucide="pin-off"></i> Fjern festede</button></div><div class="view-tools"><div class="card-sort" hidden><span>Sorter</span><select class="sr-only" data-card-sort tabindex="-1" aria-hidden="true"><option value="random">Tilfeldig rekkefølge</option><option value="title">Etter tittel</option><option value="id">Etter ID</option><option value="place">Etter sted</option><option value="collector">Etter samler</option><option value="narrator">Etter informant</option><option value="year">Etter år</option></select><details class="sort-menu" data-sort-menu><summary><span data-sort-label>Tilfeldig rekkefølge</span><i data-lucide="chevron-down"></i></summary><div class="sort-menu-options"><button type="button" data-sort-value="random" aria-pressed="true"><i data-lucide="check"></i><span>Tilfeldig rekkefølge</span></button><button type="button" data-sort-value="title" aria-pressed="false"><i data-lucide="check"></i><span>Etter tittel</span></button><button type="button" data-sort-value="id" aria-pressed="false"><i data-lucide="check"></i><span>Etter ID</span></button><button type="button" data-sort-value="place" aria-pressed="false"><i data-lucide="check"></i><span>Etter sted</span></button><button type="button" data-sort-value="collector" aria-pressed="false"><i data-lucide="check"></i><span>Etter samler</span></button><button type="button" data-sort-value="narrator" aria-pressed="false"><i data-lucide="check"></i><span>Etter informant</span></button><button type="button" data-sort-value="year" aria-pressed="false"><i data-lucide="check"></i><span>Etter år</span></button></div></details></div><div class="view-switch" aria-label="Resultatvisning"><button type="button" data-view="list"><i data-lucide="list"></i><span data-i18n="browser.list">Liste</span></button><button type="button" data-view="grid"><i data-lucide="layout-grid"></i><span data-i18n="browser.grid">Rutenett</span></button></div></div></div>
      <div class="list-head" data-list-head><button data-column-sort="id">ID <i data-lucide="arrow-up-down"></i></button><button data-column-sort="title">Tittel <i data-lucide="arrow-up-down"></i></button><span>Utdrag</span><button data-column-sort="narrator">Informant <i data-lucide="arrow-up-down"></i></button><button data-column-sort="collector">Samler <i data-lucide="arrow-up-down"></i></button><button data-column-sort="place">Sted <i data-lucide="arrow-up-down"></i></button><button data-column-sort="year">År <i data-lucide="arrow-up-down"></i></button></div>
      <ol class="results-list" data-results></ol><div class="empty" data-empty hidden><strong>Ingen sagn funnet.</strong><br/>Endre søket eller filtrene.</div><div class="pagination-row"><nav class="pagination" aria-label="Resultatsider" data-pagination></nav><label class="page-jump">Gå til <input type="number" min="1" inputmode="numeric" placeholder="side" data-page-jump /></label><div class="page-size"><span data-i18n="browser.perPage">Vis per side</span><details class="page-size-menu" data-page-size-menu><summary><span data-page-size-label>20</span><i data-lucide="chevron-down"></i></summary><div class="page-size-options"><button type="button" data-page-size="20" aria-pressed="true"><i data-lucide="check"></i><span>20</span></button><button type="button" data-page-size="50" aria-pressed="false"><i data-lucide="check"></i><span>50</span></button><button type="button" data-page-size="100" aria-pressed="false"><i data-lucide="check"></i><span>100</span></button></div></details></div></div>
    </div>
  </section>
