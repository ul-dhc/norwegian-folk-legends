---
import '../styles/global.css';
import '../styles/polish.css';
import '../styles/icons.css';
import '../styles/norske-theme.css';
import '../styles/search.css';
import '../styles/filter-panels.css';
import '../styles/tooltips.css';
import '../styles/responsive-fix.css';
import uiTranslations from '../i18n/ui.json';
const {
  title = 'Norske sagn',
  description = 'A digital explorer for Norwegian folk legends',
  active = '',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="no" data-theme="light" data-content-mode="parallel" data-ui-lang="no"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/><script is:inline>try{const d=document.documentElement,s=localStorage;d.dataset.theme=s.getItem('norske-theme')||'light';d.dataset.contentMode=s.getItem('norske-content-mode')||'parallel';d.dataset.uiLang=s.getItem('norske-ui-lang')||'no';d.style.setProperty('--font-scale',s.getItem('norske-font-scale')||'1')}catch{}</script><slot name="head"/><title>{title==='Norske sagn'?title:`${title} – Norske sagn`}</title></head><body>
<script type="application/json" id="ui-translations" is:inline set:html={JSON.stringify(uiTranslations).replace(/</g,'\u003c')}/><a class="skip-link" href="#content">Gå til innhold</a>
<header class="site-header"><div class="brand-block"><a class="wordmark" href={base}>Norske sagn</a><span class="site-subtitle">Norwegian folk legends</span></div><button class="site-menu-toggle" type="button" aria-expanded="false" aria-controls="site-header-panel"><span data-i18n="nav.menu">Meny</span><i data-lucide="menu"></i></button><div class="site-header-panel" id="site-header-panel"><nav aria-label="Hovednavigasjon"><a class:list={[{active:active==='home'}]} href={base} data-i18n="nav.home">Hjem</a><a class:list={[{active:active==='browse'}]} href={`${base}browse/`} data-i18n="nav.browse">Utforsk</a><a class:list={[{active:active==='map'}]} href={`${base}map/`} data-i18n="nav.map">Kart</a><a class:list={[{active:active==='ml'}]} href={`${base}ml-index/`} data-i18n="nav.ml">ML-indeks</a><a class:list={[{active:active==='data'}]} href={`${base}data/`} data-i18n="nav.data">Data</a><a class:list={[{active:active==='journey'}]} href={`${base}journey/`} data-i18n="nav.journey">Reiser</a><a class:list={[{active:active==='about'}]} href={`${base}about/`} data-i18n="nav.about">Om prosjektet</a></nav><div class="header-tools"><div class="mini-switch header-language"><button type="button" aria-pressed="true" data-ui-lang="no">NO</button><button type="button" aria-pressed="false" data-ui-lang="en">EN</button></div><div class="font-tools"><button type="button" data-font-down aria-label="Mindre tekst"><span>A</span><i data-lucide="minus"></i></button><button type="button" data-font-up aria-label="Større tekst"><span>A</span><i data-lucide="plus"></i></button></div><button class="icon-control theme-toggle" type="button" data-theme-toggle aria-label="Mørk modus"><i data-theme-icon data-lucide="moon"></i></button></div></div></header>
<main id="content"><slot/></main>{active === 'home' && <footer class="site-footer"><div class="institution-credit"><a href="https://dhc.lu.lv/" target="_blank" rel="noopener noreferrer">University of Latvia Digital Humanities Centre</a><span>, 2026</span></div></footer>}
<script>
  import '../scripts/site-shell';
import {attachPlatformTooltips} from '../scripts/tooltips';
attachPlatformTooltips();
</script></body></html>
