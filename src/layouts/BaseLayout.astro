---
import '../styles/global.css'; import '../styles/polish.css'; import '../styles/responsive-fix.css'; import '../styles/icons.css'; import '../styles/norske-theme.css'; import uiTranslations from '../i18n/ui.json';
const { title='Norske sagn', description='A digital explorer for Norwegian folk legends', active='' }=Astro.props; const base=import.meta.env.BASE_URL;
---
<!doctype html><html lang="no" data-theme="light" data-content-mode="parallel" data-ui-lang="no"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/><script is:inline>try{const d=document.documentElement,s=localStorage;d.dataset.theme=s.getItem('norske-theme')||'light';d.dataset.contentMode=s.getItem('norske-content-mode')||'parallel';d.dataset.uiLang=s.getItem('norske-ui-lang')||'no';d.style.setProperty('--font-scale',s.getItem('norske-font-scale')||'1')}catch{}</script><slot name="head"/><title>{title==='Norske sagn'?title:`${title} – Norske sagn`}</title></head><body>
<script type="application/json" id="ui-translations" is:inline set:html={JSON.stringify(uiTranslations).replace(/</g,'\u003c')}/><a class="skip-link" href="#content">Gå til innhold</a>
<header class="site-header"><div class="brand-block"><a class="wordmark" href={base}>Norske sagn</a></div><nav aria-label="Hovednavigasjon"><a class:list={[{active:active==='home'}]} href={base} data-i18n="nav.home">Hjem</a><a class:list={[{active:active==='browse'}]} href={`${base}browse/`} data-i18n="nav.browse">Utforsk</a><span class="nav-muted" data-i18n="nav.map">Kart</span><span class="nav-muted" data-i18n="nav.ml">ML-indeks</span><a class:list={[{active:active==='journey'}]} href={`${base}journey/`} data-i18n="nav.journey">Reise</a><span class="nav-muted" data-i18n="nav.about">Om prosjektet</span></nav><div class="header-tools"><div class="mini-switch"><button type="button" aria-pressed="true" data-ui-lang="no">NO</button><button type="button" aria-pressed="false" data-ui-lang="en">EN</button></div><div class="font-tools"><button type="button" data-font-down aria-label="Mindre tekst"><span>A</span><i data-lucide="minus"></i></button><button type="button" data-font-up aria-label="Større tekst"><span>A</span><i data-lucide="plus"></i></button></div><button class="icon-control theme-toggle" type="button" data-theme-toggle aria-label="Mørk modus"><i data-theme-icon data-lucide="moon"></i></button></div></header>
<main id="content"><slot/></main><footer class="site-footer"><div class="institution-credit"><a href="https://ul-dhc.github.io/" target="_blank" rel="noopener noreferrer">University of Latvia Digital Humanities Centre</a><span>, 2026</span></div></footer>
<script>
import {createIcons,ArrowDown,ArrowLeft,ArrowRight,ArrowUp,ArrowUpDown,CalendarDays,Check,ChevronDown,ChevronLeft,ChevronRight,Copy,Download,ExternalLink,FileStack,GitCompareArrows,Info,Layers,LayoutGrid,Link,List,MapPin,Minus,Moon,Network,NotebookPen,Pin,PinOff,Plus,Quote,RotateCcw,SlidersHorizontal,Sun,UsersRound,X} from 'lucide';
const iconSet={ArrowDown,ArrowLeft,ArrowRight,ArrowUp,ArrowUpDown,CalendarDays,Check,ChevronDown,ChevronLeft,ChevronRight,Copy,Download,ExternalLink,FileStack,GitCompareArrows,Info,Layers,LayoutGrid,Link,List,MapPin,Minus,Moon,Network,NotebookPen,Pin,PinOff,Plus,Quote,RotateCcw,SlidersHorizontal,Sun,UsersRound,X};const renderIcons=()=>createIcons({icons:iconSet,attrs:{'aria-hidden':'true','stroke-width':'1.8'}});(window as any).renderLucideIcons=renderIcons;window.addEventListener('lucide-refresh',renderIcons);renderIcons();
const doc=document.documentElement,store=localStorage,themeButton=document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;const applyTheme=(theme:string)=>{doc.dataset.theme=theme;store.setItem('norske-theme',theme);themeButton.querySelector<HTMLElement>('[data-theme-icon]')!.dataset.lucide=theme==='dark'?'sun':'moon';renderIcons()};applyTheme(doc.dataset.theme||'light');themeButton.addEventListener('click',()=>applyTheme(doc.dataset.theme==='dark'?'light':'dark'));let scale=Number(store.getItem('norske-font-scale')||1);const applyScale=(value:number)=>{scale=Math.max(.9,Math.min(1.2,value));doc.style.setProperty('--font-scale',String(scale));store.setItem('norske-font-scale',String(scale))};document.querySelector('[data-font-down]')?.addEventListener('click',()=>applyScale(scale-.1));document.querySelector('[data-font-up]')?.addEventListener('click',()=>applyScale(scale+.1));
type UiLang='no'|'en';type Entry={no:string;en:string};const ui=JSON.parse(document.querySelector('#ui-translations')!.textContent||'{}') as Record<string,Entry>,byAny=new Map<string,string>();Object.entries(ui).forEach(([key,value])=>(['no','en'] as UiLang[]).forEach(lang=>value[lang]&&byAny.set(value[lang],key)));const tr=(key:string,values:Record<string,string|number>={})=>{const lang=(doc.dataset.uiLang||'no') as UiLang;return(ui[key]?.[lang]||ui[key]?.no||key).replace(/\{(\w+)\}/g,(_,name)=>String(values[name]??''))};(window as any).teikasT=tr;(window as any).norskeT=tr;const skip=(node:Node)=>{const el=node.parentElement;return !el||!!el.closest('script,style,[data-i18n-skip],.legend-text,[data-title-lang],.result-card h2,.result-excerpt,.meta-value,.source-list')};const applyTranslations=(lang:UiLang)=>{doc.dataset.uiLang=lang;doc.lang=lang;store.setItem('norske-ui-lang',lang);document.querySelectorAll<HTMLButtonElement>('[data-ui-lang]').forEach(item=>item.setAttribute('aria-pressed',String(item.dataset.uiLang===lang)));const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);let node:Node|null;while(node=walker.nextNode()){if(skip(node))continue;const raw=node.textContent||'',trimmed=raw.trim(),key=node.parentElement?.dataset.i18n||byAny.get(trimmed);if(key&&ui[key])node.textContent=raw.replace(trimmed,ui[key][lang])}document.querySelectorAll<HTMLElement>('*').forEach(el=>{for(const attr of ['placeholder','aria-label','title'] as const){const value=el.getAttribute(attr),key=value&&byAny.get(value);if(key&&ui[key])el.setAttribute(attr,ui[key][lang])}});window.dispatchEvent(new CustomEvent('ui-language-change',{detail:lang}))};(window as any).applyTeikasUiLanguage=applyTranslations;document.querySelectorAll<HTMLButtonElement>('[data-ui-lang]').forEach(button=>button.addEventListener('click',()=>applyTranslations(button.dataset.uiLang as UiLang)));applyTranslations((doc.dataset.uiLang as UiLang)||'no');
</script></body></html>
