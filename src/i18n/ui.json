  "home.moeTitle": {"no": "Moltke Moe", "en": "Moltke Moe"},
  "home.weaveDescription": {"no": "En åpen reise gjennom steder, stemmer og sagn. Følg forbindelsene som vokser frem i landskapet.", "en": "An open-ended journey through places, voices and legends. Follow the connections as they gather in the landscape."},
  "home.threadDescription": {"no": "Et rop fra vannet, et møte med huldra, en hvileløs ånd. Følg et tema fra sted til sted.", "en": "A call from the water, an encounter with the hulder, a restless spirit. Follow a theme from place to place."},
  "home.moeDescription": {"no": "Møt stemmene fra Bø gjennom sagn, fotografier og håndskrevne sider fra arkivet.", "en": "Meet the voices of Bø through legends, photographs and handwritten pages from the archive."},
  "about.intro": {"no": "Norske sagn er en digital plattform for å utforske norske sagn og eksperimentere med digital historiefortelling, interaktive reiser og nye måter å knytte sammen fortellinger, mennesker og steder på.", "en": "Norske sagn is a digital platform for exploring Norwegian folk legends and experimenting with digital storytelling, interactive journeys and new ways of connecting stories, people and places."},
  "about.sourceTitle": {"no": "Den opprinnelige samlingen", "en": "The original collection"},
  "about.source": {"no": "Plattformen bygger på den digitale samlingen «Eventyr og sagn», opprettet av Kyrre Kverndokk og tilgjengeliggjort av Norsk Folkeminnesamling ved Universitetet i Oslo (UiO).", "en": "The platform builds on the “Eventyr og sagn” digital collection, created by Kyrre Kverndokk and made available by the Norwegian Folklore Archives at the University of Oslo (UiO)."},
  "about.sourceLink": {"no": "Besøk Eventyr og sagn ved UiO", "en": "Visit Eventyr og sagn at UiO"},
  "about.samlaTitle": {"no": "Arkivmateriale fra SAMLA", "en": "Archival materials from SAMLA"},
  "about.samla": {"no": "SAMLA er det norske digitale arkivet for tradisjons- og kulturhistoriske arkiver. SAMLA inneholder et bredt spekter av kulturelle uttrykk og praksiser fra majoritetsbefolkningen, minoritetsbefolkninger og urfolkskulturer i Norge. Samlet gir samlingene et bredt bilde av utviklingen av hverdagsliv, verdensbilder og verdier.", "en": "SAMLA is the Norwegian digital archive for the tradition and cultural history archives. SAMLA contains a wide variety of cultural expressions and practices from the majority population, minority populations, and indigenous cultures in Norway. Together, the collections provide a broad picture of the development of everyday life, worldviews and values."},
  "about.samlaLink": {"no": "Utforsk SAMLA", "en": "Explore SAMLA"},
  "about.developerTitle": {"no": "Utvikling av plattformen", "en": "Platform development"},
  "about.developerBefore": {"no": "Plattformen er utviklet av", "en": "The platform is developed by the"},
  "about.developerLink": {"no": "Digital Humanities Center ved Universitetet i Latvia", "en": "University of Latvia Digital Humanities Center"},
  "about.samlaUse": {"no": "Plattformen bruker også digitalisert arkivmateriale fra SAMLA, med lenker til kildene i arkivet.", "en": "The platform also uses digitised archival materials from SAMLA, with links to their sources in the archive."},
  "about.development": {"no": "Utviklingen startet i 2027, og plattformen er fortsatt under utvikling.", "en": "Development began in 2027, and the platform is still under development."},
  "about.contactTitle": {"no": "Kontakt", "en": "Contact"},
  "about.samlaFuture": {"no": "I fremtiden kan arkivmateriale fra SAMLA bidra til å utvide og berike plattformens sagnsamling.", "en": "In the future, archival materials from SAMLA could expand and enrich the platform’s collection of legends."}
}
