{
  "name": "norwegian-folk-legends",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "data:generate": "python3 scripts/csv_to_json.py",
    "test:journey": "pnpm build && node --test tests/journey.test.js",
    "test:map": "npm run build && node --test tests/map.test.js",
    "test:ml-index": "npm run build && node --test tests/ml-index.test.js",
    "check": "astro check",
    "test": "node --test tests/*.test.js",
    "test:all": "pnpm build && pnpm test",
    "format": "prettier --write \"src/**/*.{ts,js,css}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css}\" \"tests/**/*.js\""
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "astro": "^7.2.1",
    "leaflet": "^1.9.4",
    "lucide": "^1.31.0",
    "maplibre-gl": "^6.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^24.19.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
